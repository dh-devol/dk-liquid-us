    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile heading size",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile text size",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Image with content"
    }
  ],
  "tag": null
}
{% endschema %}