<script>
  document.addEventListener("DOMContentLoaded", function () {
    const full = document.querySelector('.bio-text-full');
    const btn = document.querySelector('.read-more-btn');
    const fullTruncated = document.querySelector('.bio-text-truncated');
    

    full.classList.remove('expanded'); // ensure hidden initially
    btn.textContent = 'Read more >';

    btn.addEventListener('click', function () {
      const isExpanded = full.classList.contains('expanded');

      if (isExpanded) {
        fullTruncated.classList.remove('hidden');
        full.classList.remove('expanded'); // smoothly collapses
        btn.textContent = 'Read more >';
      } else {
        fullTruncated.classList.add('hidden');
        full.classList.add('expanded'); // smoothly expands
        btn.textContent = '< Read less';
      }
    });
  });
</script>


{% schema %}
{
  "name": "Author Blog Articles",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "Show image"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "Show date"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": true,
      "label": "Show author"
    }
  ],
  "presets": [
    {
      "name": "Author Blog Articles",
      "blocks": []
    }
  ]
}
{% endschema %}
