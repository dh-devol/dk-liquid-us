{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-blog-post.css' | asset_url | stylesheet_tag }}

{%- assign target_author = page.metafields.custom.author_names | default: page.author | strip -%}
{%- assign author_bio = page.metafields.custom.author_bio -%}
{% assign author_position  = page.metafields.custom.author_position %}
<article class="baskerville article-template">

  <div class="brand__info-wrapper">
    <a href="/pages/blog"><img src="{{ 'devol-journal.svg' | file_url }}" width="auto" height="auto" alt="The deVOL Journal"></a>
  </div>

  <!-- Blog category menu -->
  <div class="main__blog--wrapper">  
    <div class="blog__option-wrapper">
      <div class="baskerville blog__title">
        Categories
        <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
      </div>
      <ul class="blog__options baskerville">
        {% assign blog_menu = menus['blog-menu'] %}

        {% if blog_menu %}
          {% for link in blog_menu.links %}
            <li class="blog__option">
              <a class="baskerville" href="{{ link.url }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        {% endif %}
      </ul>
    </div>
  </div>
</article>

<!-- Author bio and articles -->
<div class="author-page section-{{ section.id }}-padding">
  <div class="author-header">
    {% if page.metafields.custom.author_image %}
      <div class="author-image-wrap">
        <img src="{{ page.metafields.custom.author_image | file_url }}" width="auto" height="auto" alt="{{ target_author }}" class="author-image">
      </div>
    {% endif %}
    <div class="author-bio rte">
          <div class="blog_author-name">
      <h1>{{ target_author }}</h1>
    </div>
              <div class="blog_author-role">
      <h2>{{ author_position | metafield_tag}}</h2>
    </div>
      <div class="bio-content">
        <div class="bio-text-truncated">
          {{ author_bio | metafield_tag | truncatewords: 115, "..." }}
        </div>
        </div>
        <div class="bio-text-full">
          {{ author_bio  | metafield_tag}}
        </div>
      </div>
      <button class="read-more-btn">Read more ></button>
    </div>
  </div>

  <div class="author-articles">
    {%- liquid
      assign author_source = page.metafields.custom.author_names.value | default: page.title
      assign target_key = author_source | downcase | replace: "’", "" | replace: "'", "" | replace: ".", "" | replace: "-", "" | replace: " ", "" | strip
      assign seen_blogs = ','
    -%}
    {%- assign max_pages = 1 -%}

    {%- for link in menus['blog-menu'].links -%}
      {%- assign blog_handle = link.url | split: '/blogs/' | last | split: '/' | first | split: '?' | first -%}
      {%- assign blog_key = ',' | append: blog_handle | append: ',' -%}
      {%- if seen_blogs contains blog_key -%}{%- continue -%}{%- endif -%}
      {%- assign seen_blogs = seen_blogs | append: blog_handle | append: ',' -%}
      {%- assign blog = blogs[blog_handle] -%}
      {%- if blog == blank -%}{%- continue -%}{%- endif -%}

      {%- paginate blog.articles by 250 -%}
        {%- if paginate.pages > max_pages -%}{%- assign max_pages = paginate.pages -%}{%- endif -%}
        {%- for article in blog.articles -%}
          {%- assign author_raw = article.author | replace: ' & ', ',' | replace: ' and ', ',' | replace: ' And ', ',' -%}
          {%- assign author_parts = author_raw | split: ',' -%}
          {%- assign is_match = false -%}
          {%- for part in author_parts -%}
            {%- assign part_key = part | downcase | replace: "’", "" | replace: "'", "" | replace: ".", "" | replace: "-", "" | replace: " ", "" | strip -%}
            {%- if part_key == target_key -%}
              {%- assign is_match = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if is_match -%}
            <div class="grid__item article lazy-article" data-date="{{ article.published_at | date: '%s' }}">
              {% render 'article-card',
                blog: blog,
                article: article,
                media_aspect_ratio: 1.66,
                show_image: section.settings.show_image,
                show_date: section.settings.show_date,
                show_author: section.settings.show_author,
                show_excerpt: true
              %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endfor -%}
    <div id="author-articles-meta" hidden data-pages="{{ max_pages }}"></div>

    <script>
      document.addEventListener("DOMContentLoaded", async function () {
        const grid = document.querySelector(".author-page .author-articles");
        if (!grid) return;

        const meta = document.getElementById("author-articles-meta");
        const totalPages = parseInt((meta && meta.dataset.pages) || "1", 10);
        const sectionId = "{{ section.id }}";
        const PAGE_SIZE = 12;

        let articles = Array.from(grid.querySelectorAll(".lazy-article"));
        let renderedCount = PAGE_SIZE;
        let isLoading = false;
        let observer;

        // Hide anything beyond the current batch (CSS handles this via .js-batched)
        grid.classList.add("js-batched");

        const showUpTo = (count) => {
          articles.forEach((el, i) => el.classList.toggle("is-visible", i < count));
        };

        const loadMoreButton = document.createElement("button");
        loadMoreButton.type = "button";
        loadMoreButton.className = "blog__load-more baskerville";
        grid.after(loadMoreButton);

        const setLoadingState = (loading) => {
          isLoading = loading;
          loadMoreButton.textContent = loading ? "Loading posts..." : "Load more posts";
          loadMoreButton.disabled = loading;
          loadMoreButton.classList.toggle("is-loading", loading);
        };

        // Show the first batch straight away, then fetch older posts in the background
        showUpTo(renderedCount);
        setLoadingState(true);

        if (totalPages > 1) {
          const pageNums = Array.from({ length: totalPages - 1 }, (_, i) => i + 2);
          const pages = await Promise.all(pageNums.map((p) =>
            fetch(`${window.location.pathname}?section_id=${sectionId}&page=${p}`)
              .then((res) => (res.ok ? res.text() : ""))
              .catch((err) => { console.error("Couldn't load article page", p, err); return ""; })
          ));

          pages.forEach((html) => {
            if (!html) return;
            const doc = new DOMParser().parseFromString(html, "text/html");
            doc.querySelectorAll(".lazy-article").forEach((el) => grid.appendChild(el));
          });
        }

        // Newest first across all pages and blogs
        articles = Array.from(grid.querySelectorAll(".lazy-article"));
        articles.sort((a, b) => Number(b.dataset.date || 0) - Number(a.dataset.date || 0));
        articles.forEach((el) => grid.appendChild(el));

        showUpTo(renderedCount);
        setLoadingState(false);

        if (renderedCount >= articles.length) {
          loadMoreButton.remove();
          return;
        }

        const loadNextBatch = () => {
          if (isLoading || renderedCount >= articles.length) return;
          renderedCount += PAGE_SIZE;
          showUpTo(renderedCount);

          if (renderedCount >= articles.length) {
            loadMoreButton.remove();
            observer.disconnect();
          }
        };

        loadMoreButton.addEventListener("click", loadNextBatch);

        observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            loadNextBatch();
          },
          { rootMargin: "-250px 0px" }
        );
        observer.observe(loadMoreButton);
      });
    </script>

  </div>
