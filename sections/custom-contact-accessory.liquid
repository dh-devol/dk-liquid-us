{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{{ 'custom-contact-accessory.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="contact-form-with-details">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <div class="contact-form-with-details-wrapper color-{{ section.settings.color_scheme }} gradient  grid--1-col-tablet-down grid grid--3-col-desktop">
      <div class="email_main_wrapper grid__item">
        {%- if section.settings.email_header != blank -%}
          <h2 class="email_header contact_header w-three">{{ section.settings.email_header }}</h2>
        {% endif %}
        {%- if section.settings.email_content != blank -%}
          <div class="email_content contact_content">{{ section.settings.email_content }}</div>
        {% endif %}
      </div>
      <div class="call_main_wrapper grid__item">
        {%- if section.settings.call_header != blank -%}
          <h2 class="call_header contact_header w-three">{{ section.settings.call_header }}</h2>
        {% endif %}
        {%- if section.settings.call_content != blank -%}
          <div class="call_content contact_content">{{ section.settings.call_content }}</div>
        {% endif %}
      </div>
      <div class="contact grid__item">
        {%- if section.settings.heading != blank -%}
          <h2 class="title contact_header w-three title-wrapper--no-top-margin inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
            {{ section.settings.heading }}
          </h2>
        {%- else -%}
          <h2 class="visually-hidden">{{ 'templates.contact.form.title' | t }}</h2>
        {%- endif -%}
        {%- if section.settings.header_description != blank -%}
          <p class="header_description w-three">{{ section.settings.header_description }}</p>
        {% endif %}
        {%- liquid
          assign contact_form_class = 'isolate'
          if settings.animations_reveal_on_scroll
            assign contact_form_class = 'isolate scroll-trigger animate--fade-in'
          endif
        -%}
        {% comment %} {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
            <div class="form-success-container" tabindex="-1">
              <a name="Back to kitchen" href="/pages/kitchens" class="button button--secondary form-success-btn">Back to Kitchens</a>
              <a name="Back to kitchen" href="/pages/shop" class="button button--secondary form-success-btn">Back to Shop</a>
            </div>
             <script>
              // Redirect after 2 seconds, or immediately if you prefer
              setTimeout(function(){
                window.location.href = "/pages/accessory-enquiries";
              }, 200);
            </script>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
          {%- endif -%}

          <div class="contact__fields">
            <div class="first-last-name-wrapper">
              <div class="field">
                <label class="field__label" for="ContactForm-firstname">First name *</label>
                <input
                  class="field__input"
                  type="text"
                  id="ContactForm-firstname"
                  name="contact[first_name]"
                  placeholder="First name *"
                  required
                >
              </div>

              <div class="field">
                <label class="field__label" for="ContactForm-lastname">Last name *</label>
                <input
                  class="field__input"
                  type="text"
                  id="ContactForm-lastname"
                  name="contact[last_name]"
                  placeholder="Last name *"
                  required
                >
              </div>
            </div>

            <div class="field">
              <label class="field__label" for="ContactForm-email">Email address *</label>
              <input
                class="field__input"
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                placeholder="Email address *"
                pattern="^[^\s@]+@[^\s@]+\.[^\s@]{2,}$"
                required
              >
            </div>

