{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .custom-multicolumn.scroll-id{
    scroll-margin-top: 61px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-margin {
      margin-top: {{ section.settings.padding_top }}px;
      margin-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="custom-multicolumn {{ section.settings.sectionname }} scroll-id multicolumn color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}" id="{{ section.settings.sectionname }}">
  <div
    class="page-width section-{{ section.id }}-margin {% if section.settings.show_bottom_border %}bottom__section-border{% endif %}{% if section.settings.show_top_border %} top__section-border{% endif %} isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
        </h2>
      </div>
    {%- endunless -%}
    {% if section.settings.subtitle != blank %}
      <div class="subtitle__wrapper {% if section.settings.title != blank %}above__margin{% endif %}">
        <h3 class="sub-heading hxl">{{ section.settings.subtitle }}</h3>
    {%- assign button_label_text = section.settings.button_label | strip -%}
    {%- if button_label_text != blank and button_label_text != 'Button label' -%}
      <a href="{{ section.settings.button_link }}" class="sub_heading--link">
        {{- section.settings.button_label | escape -}}
        <span> ></span>
      </a>
    {%- endif -%}
      </div>
    {% endif %}
    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0
          for block in section.blocks
            if block.settings.image.aspect_ratio > highest_ratio
              assign highest_ratio = block.settings.image.aspect_ratio
            endif
          endfor
        -%}
        {%- for block in section.blocks -%}
          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {% assign selected_page = pages[block.settings.dynamic_costs]  %}
            {% assign feature_image = selected_page.metafields.custom.features_image.value %}
            {% assign card_link = block.settings.link %}
            {% assign product_hover_image = blank %}
            {% if block.settings.linked_product != blank %}
              {% assign card_link = block.settings.linked_product.url %}
              {% if block.settings.image == blank and feature_image == blank %}
                {% assign feature_image = block.settings.linked_product.featured_image %}
              {% endif %}
              {% if block.settings.image_hover == blank and block.settings.linked_product.images.size > 1 %}
                {% assign product_hover_image = block.settings.linked_product.images[1] %}
              {% endif %}
            {% endif %}
            <div class="multicolumn-card content-container {% if block.settings.show_text_double_column %} show_text_double_column {% endif %}">
              {% if block.settings.show_above_image %}
                {%- if block.settings.text != blank -%}
                  <div class="description_above--image">
                    <div class="rte">{{ block.settings.text }}</div>
                  </div>
                {% endif %}
              {%- endif -%}
              {%- if block.settings.image != blank or feature_image -%}
                {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                  {% assign spaced_image = true %}
                {% endif %}
                {%- if card_link != blank -%}
                  <a href="{{ card_link }}"
                    class="multicolumn-card__image-wrapper {% if block.settings.custom_text_hover != blank %}text__hover{% endif %} {% if block.settings.image_hover != blank or block.settings.custom_text_hover != blank or product_hover_image != blank %}hover__image-wrapper{% endif %} multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}"
                  >
                   {%- else -%}
                  <div
                    class="multicolumn-card__image-wrapper {% if block.settings.custom_text_hover != blank %}text__hover{% endif %} {% if block.settings.image_hover != blank or block.settings.custom_text_hover != blank or product_hover_image != blank %}hover__image-wrapper{% endif %} multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}"
                  >
                  {% endif %}
                  {% if feature_image %}
                    {% assign highest_ratio = feature_image.aspect_ratio %}
                  {% endif %}
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' %}
                      style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                      if section.settings.image_width == 'half'
                        assign image_width = 0.5
                      elsif section.settings.image_width == 'third'
                        assign image_width = 0.33
                      else
                        assign image_width = 1
                      endif
                    -%}
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                      (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                    {% endcapture %}

                    {% if feature_image %}
                        {% assign final_image = feature_image | image_url  %}
                    {% else %}
                        {% assign final_image = block.settings.image | image_url %}
                    {% endif %}

                    {{
                      final_image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '900, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'multicolumn-card__image standard__image'
                    }}
                    {% unless block.settings.custom_text_hover != blank %}
                      {% if block.settings.image_hover != blank %}
                        {{
                          block.settings.image_hover
                          | image_url: width: 3200
                          | image_tag:
                            widths: '900, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                            sizes: sizes,
                            class: 'multicolumn-card__image hover__image'
                        }}
                      {% elsif product_hover_image != blank %}
                        {{
                          product_hover_image
                          | image_url: width: 3200
                          | image_tag:
                            widths: '900, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                            sizes: sizes,
                            class: 'multicolumn-card__image hover__image'
                        }}
                      {% endif %}
                    {% else %}
                      <div class="multicolumn-card__image hover__image custom__text--on-hover">
                        <p class="inner__hover-shadow">{{ block.settings.custom_text_hover }}</p>
                      </div>
                    {% endunless %}
                  </div>
                {%- if card_link != blank -%}
                  </a>
                {%- else -%}
                  </div>
                {% endif %}
              {%- endif -%}
              <div class="multicolumn-card__info">
                  <h3 class="inline-richtext">
                    <a href="{{ card_link }}">
                      {{ block.settings.title | default: selected_page.title }}
                    </a>
                  </h3>
                {% if selected_page %}
                  {% assign selected_products_1 = selected_page.metafields.custom.product_1.value %}
                  {% assign quantities_1 = selected_page.metafields.custom.quantity_1.value %}
                  {% assign selected_products_2 = selected_page.metafields.custom.product_2.value %}
                  {% assign quantities_2 = selected_page.metafields.custom.quantity_2.value %}
                  {% assign selected_products_3 = selected_page.metafields.custom.product_3.value %}
                  {% assign quantities_3 = selected_page.metafields.custom.quantity_3.value %}
                  {% assign selected_products_4 = selected_page.metafields.custom.product_4.value %}
                  {% assign quantities_4 = selected_page.metafields.custom.quantity_4.value %}

                  {% assign total_line_price_1 = 0 %}
                  {% assign total_line_price_2 = 0 %}
                  {% assign total_line_price_3 = 0 %}
                  {% assign total_line_price_4 = 0 %}

                  {% if selected_products_1 != blank and quantities_1 != blank %}
                    {% for product in selected_products_1 %}
                      {% assign index = forloop.index0 %}
                      {% assign quantity = quantities_1[index] %}
                      {% assign line_total = product.price | times: quantity %}
                      {% assign total_line_price_1 = total_line_price_1 | plus: line_total %}
                    {% endfor %}
                  {% endif %}

                  {% if selected_products_2 != blank and quantities_2 != blank %}
                    {% for product in selected_products_2 %}
                      {% assign index = forloop.index0 %}
                      {% assign quantity = quantities_2[index] %}
                      {% assign line_total = product.price | times: quantity %}
                      {% assign total_line_price_2 = total_line_price_2 | plus: line_total %}
                    {% endfor %}
                  {% endif %}

                  {% if selected_products_3 != blank and quantities_3 != blank %}
                    {% for product in selected_products_3 %}
                      {% assign index = forloop.index0 %}
                      {% assign quantity = quantities_3[index] %}
                      {% assign line_total = product.price | times: quantity %}
                      {% assign total_line_price_3 = total_line_price_3 | plus: line_total %}
                    {% endfor %}
                  {% endif %}

                  {% if selected_products_4 != blank and quantities_4 != blank %}
                    {% for product in selected_products_4 %}
                      {% assign index = forloop.index0 %}
                      {% assign quantity = quantities_4[index] %}
                      {% assign line_total = product.price | times: quantity %}
                      {% assign total_line_price_4 = total_line_price_4 | plus: line_total %}
                    {% endfor %}
                  {% endif %}

                  {% assign grand_total = total_line_price_1
                    | plus: total_line_price_2
                    | plus: total_line_price_3
                    | plus: total_line_price_4
                  %}

                  {% if selected_page != blank and grand_total > 0  %}
                    <p class="inline-richtext sub-text">
                      <a href="{{ block.settings.link }}"
                        >Cupboard costs: {{ grand_total | money -}}
                      </a>
                    </p>
                  {% endif %}
                {% else %}
                  <p>No page selected.</p>
                {% endif %}

                {%- unless block.settings.show_above_image -%}

                  {% if block.settings.text != blank %}
                    <div class="rte">{{ block.settings.text }}</div>
                  {% else %}
                    {% if selected_page.metafields.custom.price_guide != blank %}
                      <div class="rte italic">{{ selected_page.metafields.custom.price_guide }}</div>
                    {% endif %}

                    {% if selected_page.metafields.custom.short_description != blank %}
                      <div class="rte">{{ selected_page.metafields.custom.short_description }}</div>
                    {% endif %}
                  {% endif %}

                {%- endunless -%}

                {%- if block.settings.linked_product != blank -%}
                  <a
                    class="link animate-arrow"
                    href="{{ block.settings.linked_product.url }}"
                  >
                    {{- block.settings.link_label | default: 'Order' | escape }} {{ block.settings.linked_product.price | money -}}
                  </a>
                {%- elsif block.settings.link_label != blank -%}
                  <a
                    class="link animate-arrow{% if block.settings.link contains page.handle or block.settings.link contains collection.handle  %} active{% endif %}"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% elsif block.settings.anchor != blank %}
                      href="{{ block.settings.link | append: block.settings.anchor }}"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Custom multicolumn",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Sub heading"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "t:sections.multicolumn.settings.background_style.options__2.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.multicolumn.settings.background_style.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:sections.multicolumn.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        },
        {
          "value": "3",
          "label": "3 columns"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "For developer use"
    },
    {
      "type": "text",
      "id": "sectionname",
      "label": "Do not edit"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label",
          "info": "If you link a page to the project, the images will be taken from that page’s settings."
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Anchor tag",
          "info": "Please add a '#' before the tag"
        },
        {
          "type": "page",
          "id": "dynamic_costs",
          "label": "Select page for dynamic costs"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "image_hover",
          "label": "Image",
          "info": "Appear on hover with an animation"
        },
        {
          "type": "inline_richtext",
          "id": "custom_text_hover",
          "label": "Hover text",
          "info": "If it's not blank, it appears on hover"
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "t:sections.multicolumn.blocks.column.settings.title.default",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "checkbox",
          "id": "show_text_double_column",
          "label": "Double columns text",
          "default": false
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.multicolumn.blocks.column.settings.text.default",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        },
        {
          "type": "checkbox",
          "id": "show_above_image",
          "label": "Show description above image",
          "default": false
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label.label"
        },
        {
          "type": "product",
          "id": "linked_product",
          "label": "Linked product",
          "info": "When set, the link label shows 'Order for <price>' and links to the product page. Overrides the link and link label above."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom multicolumn"
    }
  ]
}
{% endschema %}
