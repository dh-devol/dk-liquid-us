{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-padding .brochure-main-wrapper,
  .section-{{ section.id }}-padding .brochure-iframe-wrapper {
    width: 100%;
  }

  .section-{{ section.id }}-padding .brochure-iframe-wrapper {
    position: relative;
    max-width: 100%;
    aspect-ratio: 1248 / 882;
  }

  .section-{{ section.id }}-padding .brochure-iframe-wrapper iframe {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
  }

{%- endstyle -%}

<div class="page-width fipbook-brochure color-{{ section.settings.color_scheme }} gradient">
  <div class="section-{{ section.id }}-padding">
    <div class="brochure-main-wrapper">
      <div class="brochure-iframe-wrapper">
        <iframe
          src="https://view.publitas.com/{{ section.settings.account_name }}/{{ section.settings.catalog_name }}?publitas_embed=embedded"
          width="100%"
          height="100%"
          style="border: none;"
          allowfullscreen="true"
          frameborder="0"
        >
        </iframe>
      </div>
    </div>
  </div>
</div>
{% schema %} 
  {
  "name": "Flipbook brochure",
  "settings": [
    {
      "type": "text",
      "id": "account_name",
      "label": "Your account name"
    },
    {
      "type": "text",
      "id": "catalog_name",
      "label": "Your catalog name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Flipbook brochure",
    }
  ]
}
{% endschema %}
