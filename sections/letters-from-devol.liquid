{% assign ai_gen_id = section.settings.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-content-block-{{ ai_gen_id }} {
    display: flex;
    min-height: {{ section.settings.min_height }}px;
    max-height: 750px;
  }
    .ai-block-inner-content {
        padding: 4em 3em;
        max-width: 476px;
        margin: auto;
        width: auto;
    }
    .ai-block-inner-content form {
        width: 100%
    }
   .ai-block-inner-content form label.field__label {
        position: static;
        font-size: 14px;
    }

    .ai-block-inner-content form .field {
        display: flex;
        flex-direction: column;
    }

    .ai-block-inner-content form .field__input {
        border: 1px solid #bfbfbf;
        height: 31px;
        padding: .5rem 10px;
        margin-top: 0.4em;
        margin-bottom: 1em;
    }

    .ai-block-inner-content form .field:after {
        content: none;
    }
  .ai-image-content-block__image-{{ ai_gen_id }} {
    flex: 1;
    position: relative;
    overflow: hidden;
  }

  .ai-image-content-block__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-image-content-block__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-content-block__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-content-block__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-image-content-block__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    color: #666;
    font-size: 14px;
    text-align: center;
  }

  .ai-image-content-block__content-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ section.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: {{ section.settings.content_background_color }};
    color: {{ section.settings.text_color }};
  }

  .ai-image-content-block__heading-{{ ai_gen_id }} {
    font-size: {{ section.settings.heading_size }}px;
    margin: 0 0 {{ section.settings.heading_margin }}px 0;
    color: {{ section.settings.heading_color }};
    line-height: 1.2;
  }

  .ai-image-content-block__text-{{ ai_gen_id }} {
    font-size: {{ section.settings.text_size }}px;
    line-height: 1.5;
    margin: 0 0 {{ section.settings.text_margin }}px 0;
  }

  .ai-image-content-block__buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ section.settings.button_gap }}px;
    flex-wrap: wrap;
  }

  .ai-image-content-block__button-{{ ai_gen_id }} {
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: {{ section.settings.button_text_size }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-image-content-block__button--primary-{{ ai_gen_id }} {
    background-color: {{ section.settings.primary_button_bg_color }};
    color: {{ section.settings.primary_button_text_color }};
  }

  .ai-image-content-block__button--primary-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.primary_button_hover_bg_color }};
    color: {{ section.settings.primary_button_hover_text_color }};
  }

  .ai-image-content-block__button--secondary-{{ ai_gen_id }} {
    background-color: {{ section.settings.secondary_button_bg_color }};
    color: {{ section.settings.secondary_button_text_color }};
    border: 2px solid {{ section.settings.secondary_button_border_color }};
  }

  .ai-image-content-block__button--secondary-{{ ai_gen_id }}:hover {
    background-color: {{ section.settings.secondary_button_hover_bg_color }};
    color: {{ section.settings.secondary_button_hover_text_color }};
    border-color: {{ section.settings.secondary_button_hover_border_color }};
  }
  a.accessory-btn {
    border: 1px solid rgba(0, 0, 0, 0.3);
    color: #746f74;
    padding: 0.25em 2em 0.3em;
    margin-right: 1.2em;
    min-width: 173px;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-image-content-block-{{ ai_gen_id }} {
      flex-direction: {% if section.settings.mobile_layout == 'image_first' %}column{% else %}column-reverse{% endif %};
      min-height: auto;
    }

    .ai-image-content-block__image-{{ ai_gen_id }} {
      display: none
    }

    .ai-image-content-block__content-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-image-content-block__heading-{{ ai_gen_id }} {
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .ai-image-content-block__text-{{ ai_gen_id }} {
      font-size: {{ section.settings.mobile_text_size }}px;
    }

    .ai-image-content-block__buttons-{{ ai_gen_id }} {
      flex-direction: {% if section.settings.mobile_button_layout == 'stacked' %}column{% else %}row{% endif %};
    }
  }
{% endstyle %}

<div class="ai-image-content-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-content-block__image-{{ ai_gen_id }}">
    <div class="ai-image-content-block__image-wrapper-{{ ai_gen_id }}">
      {% if section.settings.image %}
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          alt="{{ section.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% else %}
        <div class="ai-image-content-block__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-image-content-block__empty-state-{{ ai_gen_id }}">
            Add an image to get started
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="ai-image-content-block__content-{{ ai_gen_id }}">
    <div class="ai-block-inner-content">
    {% if section.settings.heading != blank %}
      <h2 class="ai-image-content-block__heading-{{ ai_gen_id }}">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="ai-image-content-block__text-{{ ai_gen_id }}">
        {{ section.settings.text }}
      </div>
    {% endif %}

    <div class="ai-image-content-block__buttons-{{ ai_gen_id }}">
      
      {%- form 'contact', id: 'ContactForm', class: contact_form_class -%}
          {%- if form.posted_successfully? -%}
            <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
              {{- 'icon-success.svg' | inline_asset_content -}}
              {{ 'templates.contact.form.post_success' | t }}
            </h2>
            <div class="form-success-container" tabindex="-1">
              <a name="Back to kitchen" href="/pages/kitchens" class="button button--secondary form-success-btn">Back to Kitchens</a>
              <a name="Back to kitchen" href="/pages/shop" class="button button--secondary form-success-btn">Back to Shop</a>
            </div>
             <script>
              // Redirect after 2 seconds, or immediately if you prefer
              setTimeout(function(){
                window.location.href = "/pages/thanks";
              }, 200);
            </script>
          {%- elsif form.errors -%}
            <div class="form__message">
              <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                {{- 'icon-error.svg' | inline_asset_content -}}
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
            </div>
          {%- endif -%}

          <div class="contact__fields">
            <div class="first-last-name-wrapper">
              <div class="field">
                <label class="field__label" for="ContactForm-firstname">First name *</label>
                <input
                  class="field__input"
                  type="text"
                  id="ContactForm-firstname"
                  name="contact[first_name]"
                  placeholder="First name *"
                  required
                >
              </div>

              <div class="field">
                <label class="field__label" for="ContactForm-lastname">Last name *</label>
                <input
                  class="field__input"
                  type="text"
                  id="ContactForm-lastname"
                  name="contact[last_name]"
                  placeholder="Last name *"
                  required
                >
              </div>
            </div>

            <div class="field">
              <label class="field__label" for="ContactForm-email">Email address *</label>
              <input
                class="field__input"
                type="email"
                id="ContactForm-email"
                name="contact[email]"
                placeholder="Email address *"
                pattern="^[^\s@]+@[^\s@]+\.[^\s@]{2,}$"
                required
              >
            </div>
          </div>

          <div class="contact__button">
            <button type="submit" class="button">Sign me up</button>
          </div>
        {%- endform -%}
        {% if section.settings.privacymessage != blank %}
          <div class="ai-image-content-block__text-{{ ai_gen_id }}">
            {{ section.settings.privacymessage }}
          </div>
        {% endif %}
    </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Letters from deVOL",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Minimum height",
      "default": 500
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your heading here"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your descriptive text here. This content will appear alongside your image.</p>"
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 20,
      "max": 80,
      "step": 10,
      "unit": "px",
      "label": "Content padding",
      "default": 40
    },
    {
      "type": "richtext",
      "id": "privacymessage",
      "label": "Privacy message",
      "default": "<p>By signing up you agree to our Privacy Policy. You can unsubscribe at any time.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "content_background_color",
      "label": "Content background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 36
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 16
    },
    {
      "type": "range",
      "id": "heading_margin",
      "min": 10,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Heading bottom margin",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_margin",
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Text bottom margin",
      "default": 30
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "image_first",
          "label": "Image above content"
        },
        {
          "value": "content_first",
          "label": "Content above image"
        }
      ],
      "default": "content_first"
    },
    {
      "type": "select",
      "id": "mobile_button_layout",
      "label": "Mobile button layout",
      "options": [
        {
          "value": "inline",
          "label": "Side by side"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "min": 200,
      "max": 500,
      "step": 50,
      "unit": "px",
      "label": "Mobile image height",
      "default": 300
    },
    {
      "type": "range",
      "id": "mobile_content_padding",
      "min": 15,
      "max": 40,
      "step": 5,
      "unit": "px",
      "label": "Mobile content padding",
      "default": 25
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 18,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile heading size",
      "default": 28
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile text size",
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Letters from deVOL"
    }
  ]
}
{% endschema %}