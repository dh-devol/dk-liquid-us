<div data-product-wrapper>
  <product-info
    id="MainProduct-{{ section.id }}"
    class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
    data-section="{{ section.id }}"
    data-product-id="{{ product.id }}"
    data-update-url="true"
    data-url="{{ product.url }}"
    {% if section.settings.image_zoom == 'hover' %}
      data-zoom-on-hover
    {% endif %}
  >
    {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
    {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
    {{ 'component-price.css' | asset_url | stylesheet_tag }}
    {{ 'component-slider.css' | asset_url | stylesheet_tag }}
    {{ 'component-rating.css' | asset_url | stylesheet_tag }}
    {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

    {% unless product.has_only_default_variant %}
      {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
      {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
      {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
    {% endunless %}
    {%- if product.quantity_price_breaks_configured? -%}
      <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
      {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    {%- style -%}
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
        }
      }
    {%- endstyle -%}

    <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
    {% if section.settings.image_zoom == 'hover' %}
      <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
    {%- if first_3d_model -%}
      {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
      <link
        id="ModelViewerStyle"
        rel="stylesheet"
        href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
        media="print"
        onload="this.media='all'"
      >
      <link
        id="ModelViewerOverride"
        rel="stylesheet"
        href="{{ 'component-model-viewer-ui.css' | asset_url }}"
        media="print"
        onload="this.media='all'"
      >
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
    <div class="page-width">
      <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col grid--2-col-tablet">
        <div class="grid__item product__media-wrapper">
          {% if section.settings.gallery_layout == 'custom_slider' %}
            {% render 'custom-slider' %}
          {% else %}
            {% render 'product-media-gallery', variant_images: variant_images %}
          {% endif %}
        </div>
        <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}">
          <section
            id="ProductInfo-{{ section.id }}"
            class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
          >
            {%- assign product_form_id = 'product-form-' | append: section.id -%}
            {%- assign has_quantity_selector_block = false -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'quantity_selector' -%}
                {%- assign has_quantity_selector_block = true -%}
              {%- endif -%}
            {%- endfor -%}
            <script type="application/json" id="ProductInventory-{{ section.id }}">
              {
                {%- for variant in product.variants -%}
                  "{{ variant.id }}": {
                    "quantity": {{ variant.inventory_quantity | default: 0 | json }},
                    "policy": {{ variant.inventory_policy | json }},
                    "management": {{ variant.inventory_management | json }}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              }
            </script>
            {%- comment -%}
              International OOS: Flooring is not purchasable outside the UK and US.
              This is a purely geographic gate (independent of stock/availability) so
              it also fires for countries with no defined Shopify market, where the
              variant falls back to an available market (e.g. Bosnia).
            {%- endcomment -%}
            {%- assign _int_oos_type = settings.flooring_product_type | default: 'Flooring' -%}
            {%- assign show_international_oos = false -%}
            {%- if product.type == _int_oos_type
                and localization.country.iso_code != 'GB'
                and localization.country.iso_code != 'US' -%}
              {%- assign show_international_oos = true -%}
            {%- endif -%}
            <div id="int-oos-debug" style="display:none">
              DEBUG — product.type=[{{ product.type }}] | _int_oos_type=[{{ _int_oos_type }}]
              | localization.country.iso_code=[{{ localization.country.iso_code }}]
              | localization.market.handle=[{{ localization.market.handle }}]
              | request.country=[{{ request.country.iso_code }}]
              | variant.available=[{{ product.selected_or_first_available_variant.available }}]
              | show_international_oos=[{{ show_international_oos }}]
            </div>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {% render block %}
                {%- when 'text' -%}
                  <p
                    class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{- block.settings.text -}}
                  </p>
                {%- when 'breadcrumb' -%}
                  {% render 'breadcrumb' %}
                {%- when 'title' -%}
                  <div class="product__title" {{ block.shopify_attributes }}>
                    <h1>
                      {% if product.metafields.custom.custom_product_title.value != blank %}
                        {{ product.metafields.custom.custom_product_title.value }}
                      {% else %}
                        {{ product.title | escape }}
                      {% endif %}
                    </h1>

                    <a href="{{ product.url }}" class="product__title">
                      <h2 class="h1">
                        {% if product.metafields.custom.custom_product_title.value != blank %}
                          {{ product.metafields.custom.custom_product_title.value }}
                        {% else %}
                          {{ product.title | escape }}
                        {% endif %}
                      </h2>
                    </a>
                    {%- if product.type == 'Flooring' and product.metafields.custom.flooring_dimension != blank -%}
                      <p class="product__dimension-subtitle" id="product-dimension-subtitle-{{ section.id }}">
                        {{- product.metafields.custom.flooring_dimension -}}
                      </p>
                    {%- endif -%}
                  </div>
                {%- when 'price' -%}
                  <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                    {%- render 'price',
                      product: product,
                      root_id: 'mm-bundle-' | append: block.id,
                      use_variant: true,
                      show_badges: true,
                      price_class: 'price--large'
                    -%}
                  </div>
                  {%- if product.quantity_price_breaks_configured? -%}
                    <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                      <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                    </div>
                  {%- endif -%}
                  {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                    <div class="product__tax caption rte">
                      {%- if cart.duties_included and cart.taxes_included -%}
                        {{ 'products.product.duties_and_taxes_included' | t }}
                      {%- elsif cart.taxes_included -%}
                        {{ 'products.product.taxes_included' | t }}
                      {%- elsif cart.duties_included -%}
                        {{ 'products.product.duties_included' | t }}
                      {%- endif -%}
                      {%- if shop.shipping_policy.body != blank -%}
                        {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <div {{ block.shopify_attributes }}>
                    {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                    {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                      {{ form | payment_terms }}
                    {%- endform -%}
                  </div>
                {% when 'mix_and_match_bundle' %}
                  {%
                    render 'mix-and-match-bundle',
                    root_id: 'mm-bundle-' | append: block.id,
                    limit: block.settings.limit,
                    bundle_product: block.settings.bundle_product,
                    fast_bundle_id: block.settings.fast_bundle_id,
                    item_label_prefix: block.settings.item_label_prefix,
                    products_list: block.settings.bundle_products,
                    bundle_first_option: block.settings.first_option,
                    item_label_styling: block.settings.item_label_styling,
                    bundle_price: block.settings.bundle_add_pricing,
                    add_on_styling: block.settings.add_on_style,
                    bundle_qty: block.settings.bundle_qty
                  %}
                {%- when 'inventory' -%}
                  {%- if show_international_oos and settings.international_oos_text != blank -%}
                    <div class="not-for-sale not-for-sale--oos" id="Inventory-{{ section.id }}">
                      {% comment %} <p style="color: #898989">Unavailable to order online</p> {% endcomment %}
                      {{ settings.international_oos_text }}
                    </div>
                  {%- elsif product.metafields.custom.lead_time.value != blank -%}
                    <p
                      class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                      {{ block.shopify_attributes }}
                      id="Inventory-{{ section.id }}"
                      role="status"
                    >
                      {%- assign variant = product.selected_or_first_available_variant -%}
                        {%- if variant.available -%}
                          {%- render 'lead-time-text', product: product, variant: variant -%}
                        {%- else -%}
                          {{- 'products.product.inventory_out_of_stock' | t -}}
                        {%- endif -%}
                    </p>
                  {%- elsif product.type == 'Not for Sale' -%}
                    <div class="not-for-sale">
                      <p>Unavailable to order online</p>
                      {{ section.settings.not_for_sale_text }}
                    </div>
                  {%- else -%}
                    <p
                      class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                      {{ block.shopify_attributes }}
                      id="Inventory-{{ section.id }}"
                      role="status"
                    >
                      {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                        {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                          {%- if product.selected_or_first_available_variant.inventory_quantity
                              <= block.settings.inventory_threshold
                          -%}
                            <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {%- if block.settings.show_inventory_quantity -%}
                              {{-
                                'products.product.inventory_low_stock_show_count'
                                | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                              -}}
                            {%- else -%}
                              {{- 'products.product.inventory_low_stock' | t -}}
                            {%- endif -%}
                          {%- else -%}
                            <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {%- if block.settings.show_inventory_quantity -%}
                              {{-
                                'products.product.inventory_in_stock_show_count'
                                | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                              -}}
                            {%- else -%}
                              {{- 'products.product.inventory_in_stock' | t -}}
                            {%- endif -%}
                          {%- endif -%}
                        {%- else -%}
                          {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                            <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                          {%- else -%}
                            <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                              {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                            </span>
                            {{- 'products.product.inventory_out_of_stock' | t -}}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                {%- when 'description' -%}
                  {%- render 'product-description', block: block, product: product %}
                {%- when 'sku' -%}
                  <p
                    class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                    id="Sku-{{ section.id }}"
                    role="status"
                    {{ block.shopify_attributes }}
                  >
                    <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                    {{- product.selected_or_first_available_variant.sku -}}
                  </p>
                {%- when 'custom_liquid' -%}
                  {{ block.settings.custom_liquid }}
                {%- when 'collapsible_tab' -%}
                  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                    <details id="Details-{{ block.id }}-{{ section.id }}">
                      <summary>
                        <div class="summary__title">
                          {% render 'icon-accordion', icon: block.settings.icon %}
                          <h2 class="h4 accordion__title inline-richtext">
                            {{ block.settings.heading | default: block.settings.page.title | escape }}
                          </h2>
                        </div>
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </summary>
                      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                        {{ block.settings.content }}
                        {{ block.settings.page.content }}
                      </div>
                    </details>
                  </div>
                {% when 'quantity_buy_button' %}
                  {%- unless show_international_oos -%}
                    {% if product.metafields.custom.unit_area_m2.value == blank %}
                      {% render 'product-quantity-buy-button', block: block, product: product, product_form_id: product_form_id %}
                    {% endif %}
                  {%- endunless -%}
                {%- when 'quantity_selector' -%}
                  {%- unless show_international_oos -%}
                    {% if product.metafields.custom.unit_area_m2.value != blank %}
                      {% render 'product-quantity-coverage',
                        block: block,
                        product: product,
                        product_form_id: product_form_id,
                        section_id: section.id,
                        show_pickup_availability: true
                      %}
                    {% else %}
                      {% render 'product-quantity-selector', block: block, product: product %}
                    {% endif %}
                  {%- endunless -%}
                {% when 'sample-pack-button' %}
                  {% render 'product-sample-pack-button', block: block, product: product %}
                {%- when 'popup' -%}
                  <modal-opener
                    class="product-popup-modal__opener quick-add-hidden"
                    data-modal="#PopupModal-{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    <button
                      id="ProductPopup-{{ block.id }}"
                      class="product-popup-modal__button link"
                      type="button"
                      aria-haspopup="dialog"
                    >
                      {{ block.settings.text | default: block.settings.page.title | escape }}
                    </button>
                  </modal-opener>
                {%- when 'share' -%}
                  {% liquid
                    assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                    render 'share-button', block: block, share_link: share_url
                  %}

                {%- when 'metafield_product' -%}
                  {% render 'product-metafield-product', product: product, block: block %}
                {%- when 'variant_picker' -%}
                  {%- unless show_international_oos -%}
                    {% render 'product-variant-picker',
                      product: product,
                      block: block,
                      product_form_id: product_form_id
                    %}
                  {%- endunless -%}
                {%- when 'buy_buttons' -%}
                  {%- if show_international_oos -%}
                    <div class="product-form">
                      <div class="product-form__buttons form">
                        <button
                          type="button"
                          class="product-form__submit button button--full-width button--primary"
                          disabled
                        >
                          Unavailable to order online
                        </button>
                      </div>
                    </div>
                  {%- elsif product.metafields.custom.unit_area_m2.value == blank %}
                    {% if product.metafields.custom.number_of_tile_for_coverage_1m2
                      or tile_type == 'free length'
                      or tile_type == 'variable pack'
                      or tile_type == 'fixed tile'
                      or tile_type == 'fixed pack'
                    %}
                      {%- render 'buy-buttons',
                        block: block,
                        product: product,
                        product_form_id: product_form_id,
                        section_id: section.id,
                        show_pickup_availability: true
                      -%}
                    {% endif %}
                  {% else %}
                    {% unless has_quantity_selector_block %}
                      {% render 'product-quantity-coverage',
                        block: block,
                        product: product,
                        product_form_id: product_form_id,
                        section_id: section.id,
                        show_pickup_availability: true,
                        show_add_to_cart: true
                      %}
                    {% endunless %}
                  {% endif %}
                {%- when 'rating' -%}
                  {%- if product.metafields.reviews.rating.value != blank -%}
                    <div class="rating-wrapper">
                      {% liquid
                        assign rating_decimal = 0
                        assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                        if decimal >= 0.3 and decimal <= 0.7
                          assign rating_decimal = 0.5
                        elsif decimal > 0.7
                          assign rating_decimal = 1
                        endif
                      %}
                      <div
                        class="rating"
                        role="img"
                        aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                      >
                        <span
                          aria-hidden="true"
                          class="rating-star"
                          style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                        ></span>
                      </div>
                      <p class="rating-text caption">
                        <span aria-hidden="true">
                          {{- product.metafields.reviews.rating.value }} /
                          {{ product.metafields.reviews.rating.value.scale_max -}}
                        </span>
                      </p>
                      <p class="rating-count caption">
                        <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                        <span class="visually-hidden">
                          {{- product.metafields.reviews.rating_count }}
                          {{ 'accessibility.total_reviews' | t -}}
                        </span>
                      </p>
                    </div>
                  {%- endif -%}
                {%- when 'complementary' -%}
                  {% render 'product-complementary', product: product, section: section, block: block %}

                {%- when 'icon-with-text' -%}
                  {% render 'icon-with-text', block: block %}
              {%- endcase -%}
            {%- endfor -%}
            <a href="{{ product.url }}" class="link product__view-details animate-arrow">
              {{ 'products.product.view_full_details' | t }}
              {{- 'icon-arrow.svg' | inline_asset_content -}}
            </a>
          </section>
        </div>
      </div>

      {% render 'product-media-modal', variant_images: variant_images %}

      {% assign popups = section.blocks | where: 'type', 'popup' %}
      {%- for block in popups -%}
        <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
          <div
            role="dialog"
            aria-label="{{ block.settings.text }}"
            aria-modal="true"
            class="product-popup-modal__content"
            tabindex="-1"
          >
            <button
              id="ModalClose-{{ block.id }}"
              type="button"
              class="product-popup-modal__toggle"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
            <div class="product-popup-modal__content-info">
              <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
              {{ block.settings.page.content }}
            </div>
          </div>
        </modal-dialog>
      {%- endfor -%}

      {%- if product.media.size > 0 -%}
        <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
        <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}

      {%- liquid
        if product.selected_or_first_available_variant.featured_media
          assign seo_media = product.selected_or_first_available_variant.featured_media
        else
          assign seo_media = product.featured_media
        endif
      -%}

      <script type="application/ld+json">
        {{ product | structured_data }}
      </script>
    </div>
  </product-info>
</div>


<script>
document.addEventListener("DOMContentLoaded", () => {
  initProductSwitcher();
  initSwiperGallery();
  initCoverageCalculators(document);
  
  {% if product.metafields.custom.read_more.value %}
  readmoreDescription();
  {%  endif %}

  function restyleBrassAddons() {
    var container = document.querySelector('#rbr-container-element-addOn [class*="style_items_"]');
    if (!container) return false;

    /* Trim titles to just the position name */
    container.querySelectorAll('[class*="style_title_"] > span:first-child').forEach(function(span) {
      var text = span.textContent;
      var dashIdx = text.lastIndexOf('-');
      if (dashIdx > -1) {
        span.textContent = text.substring(dashIdx + 1).trim();
      }
    });

    /* Read Liquid-rendered prices (tax-inclusive) */
    var prices = window.__brassAddonPrices || {};
    var headingText = 'Add a brass towel rail';
    var vals = Object.values(prices);
    if (vals.length > 0) {
      var allSame = vals.every(function(v) { return v === vals[0]; });
      if (allSame) {
        headingText += ' (' + vals[0] + ' each):';
      } else if (prices.front && prices.left && prices.right && prices.left === prices.right) {
        headingText += ' (' + prices.front + ' for front, ' + prices.left + ' for sides):';
      } else {
        var parts = [];
        for (var k in prices) { parts.push(prices[k] + ' for ' + k); }
        headingText += ' (' + parts.join(', ') + '):';
      }
    }

    /* Remove old heading if present, then insert fresh */
    var oldHeading = container.querySelector('.add-on-heading');
    if (oldHeading) oldHeading.remove();
    var heading = document.createElement('p');
    heading.className = 'add-on-heading';
    heading.textContent = headingText;
    container.insertBefore(heading, container.firstChild);

    /* Switch quantity/button wrapper to column layout when addon is present */
    var qtyWrapper = document.querySelector('.product .quantity_buy_button-wrapper');
    if (qtyWrapper) qtyWrapper.classList.add('has-addon');

    return true;
  }

  /* Persistent observer for Fast Bundles addon restyle */
  (function() {
    var debounceTimer;
    var observer = new MutationObserver(function() {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(restyleBrassAddons, 100);
    });
    var target = document.querySelector('#rbr-container-element-addOn') || document.body;
    observer.observe(target, { childList: true, subtree: true });
    restyleBrassAddons();
  })();

  function initProductSwitcher() {
    const variantDataElement = document.getElementById("variantMap");
    if (!variantDataElement) return;

    let variantMap;
    try {
      variantMap = JSON.parse(variantDataElement.textContent.trim());
    } catch (e) {
      console.error("Invalid variantMap JSON", e);
      return;
    }

    const selectorWrapper = document.getElementById("custom-select-wrapper");
    if (!selectorWrapper) return;

    const selects = selectorWrapper.querySelectorAll("select");

    //kishan
    function toggleFinishDropdown() {
      const sizeSelect = selectorWrapper.querySelector(
        'select[name="select-a-size"]'
      );

      const finishSelect = selectorWrapper.querySelector(
        'select[name="select-a-finish"]'
      );

      if (!sizeSelect || !finishSelect) return;

      const finishLabel = finishSelect.previousElementSibling;

      const isIndividual =
        sizeSelect.value === 'individual-hooks-no-rack';

      finishSelect.style.display = isIndividual ? 'none' : '';

      if (finishLabel?.tagName === 'LABEL') {
        finishLabel.style.display = isIndividual ? 'none' : '';
      }
    }

    toggleFinishDropdown();

    function toggleSwitchDropdown() {
      const pattressSelect = selectorWrapper.querySelector(
        'select[name="select-a-wooden-pattress"]'
      );

      const switchSelect = selectorWrapper.querySelector(
        'select[name="select-your-switch-module"]'
      );

      if (!pattressSelect || !switchSelect) return;

      const switchLabel = switchSelect.previousElementSibling;

      const withPattress =
        pattressSelect.value != 'without-pattress';

      switchSelect.style.display = withPattress ? 'none' : 'block';

      if (switchLabel?.tagName === 'LABEL') {
        switchLabel.style.display = withPattress ? 'none' : 'block';
      }
    }
    toggleSwitchDropdown();

    const rootPath = {{ routes.root_url | json }};
    const basePath = (rootPath || "").replace(/\/$/, "");

    // Safer than :has(...); product-info carries data-section="{{ section.id }}"
    const getSectionId = () => document.querySelector("product-info[data-section]")?.dataset.section || null;

    selectorWrapper.addEventListener("change", () => {
      toggleFinishDropdown();
      toggleSwitchDropdown();
      const selected = {};
      selects.forEach((sel) => {
        // select names and values are already handleized in Liquid
        selected[sel.name] = (sel.value || "").toLowerCase();
      });

      const match = Object.entries(variantMap).find(([handle, options]) => {
        return Object.entries(selected).every(([key, value]) => {
          //Only do if the option doesn't exist e.g no finish for Individual hooks
          if (!options[key]) return true;
          return options[key] === value;
        });
      });

      if (!match) return;

      const [targetHandle, matchedOptions] = match;

      // Immediate safety net: point add-to-cart at the matched child variant
      if (matchedOptions.__variant_id) {
        const idInput =
          document.querySelector('input.product-variant-id[name="id"]') ||
          document.querySelector('form[action*="/cart/add"] input[name="id"]');
        if (idInput) idInput.value = matchedOptions.__variant_id;
      }

      // Skip if already on the selected handle
      const currentHandle = (location.pathname.split('/products/')[1] || '').split('/')[0];
      if (targetHandle === currentHandle) return;

      const sectionId = getSectionId();
      const targetPath = `${basePath}/products/${targetHandle}`;

      const bundle = document.querySelector('.mm-bundle');

      // needed for heritage switches 1 gang
      let currentPattress = false;
      let targetPattress = false;
      if (currentHandle.includes("mahogany") || currentHandle.includes("maple")) {
        currentPattress = true;
      }
      if (targetHandle.includes("mahogany") || targetHandle.includes("maple")) {
        targetPattress = true;
      }

      // If we can't resolve the current section id, do a hard navigation or if bundle
      if (!sectionId || bundle || targetPattress != currentPattress) {
        window.location.assign(targetPath);
        return;
      }

      // Targeted AJAX swap: only update elements that differ between swatch products
      fetch(`${targetPath}?section_id=${encodeURIComponent(sectionId)}`)
        .then((res) => res.text())
        .then((html) => {
          const doc = new DOMParser().parseFromString(html, "text/html");
          const newWrapper = doc.querySelector("[data-product-wrapper]");
          const curWrapper = document.querySelector("[data-product-wrapper]");

          if (!newWrapper || !curWrapper) {
            window.location.assign(targetPath);
            return;
          }

          curWrapper.innerHTML = newWrapper.innerHTML;

          // Execute scripts from injected HTML
          curWrapper.querySelectorAll('script').forEach(oldScript => {
            const newScript = document.createElement('script');

            [...oldScript.attributes].forEach(attr => {
              newScript.setAttribute(attr.name, attr.value);
            });

            newScript.textContent = oldScript.textContent;

            oldScript.parentNode.replaceChild(newScript, oldScript);
          });

          history.replaceState(null, "", targetPath);

          // Clean up addon state when switching to a non-addon product
          var qtyWrapper = document.querySelector('.product .quantity_buy_button-wrapper');
          if (qtyWrapper) qtyWrapper.classList.remove('has-addon');

          // Re-init for newly injected DOM (not initProductSwitcher — selector persists)
          initProductSwitcher();
          initSwiperGallery();
          initCoverageCalculators(curWrapper);
          initAccordionScript(curWrapper);
          readmoreDescription();
        })
        .catch(() => window.location.assign(targetPath));
    });
  }

  function loadScriptOnce(src, id, callback) {
    if (document.getElementById(id)) {
      if (typeof callback === "function") callback();
      return;
    }
    const script = document.createElement("script");
    script.src = src;
    script.defer = true;
    script.id = id;
    if (typeof callback === "function") {
      script.addEventListener("load", callback, { once: true });
    }
    document.head.appendChild(script);
  }

  function initCoverageCalculators(root) {
    const scope = root || document;
    const calcWrapper = scope.querySelector(".quantity_coverage-main-wrapper");
    if (!calcWrapper) return;

    const calcType = calcWrapper.dataset.calculator || "";
    const tileCalcSrc = {{ 'tile_calculator_single.js' | asset_url | json }};
    const flooringCalcSrc = {{ 'flooring_calculator_single.js' | asset_url | json }};

    if (calcType === "tile") {
      loadScriptOnce(tileCalcSrc, "tile-calculator-script", () => {
        if (typeof window.initTileCalculator === "function") {
          window.initTileCalculator(scope);
        }
      });
      return;
    }

    if (calcType === "flooring") {
      loadScriptOnce(flooringCalcSrc, "flooring-calculator-script", () => {
        if (typeof window.initFlooringCalculator === "function") {
          window.initFlooringCalculator(scope);
        }
      });
      return;
    }
  }

  function initSwiperGallery() {
    const swiperEl = document.querySelector('.product-gallery-swiper');
    if (!swiperEl) return;

    const isMobile = window.matchMedia('(max-width: 749px)').matches;

    const options = {
      slidesPerView: 1,
      loop: true,
      pagination: {
        el: '.product-gallery-swiper .swiper-pagination',
        clickable: true,
      },
    };

    if (isMobile) {
      // Mobile: slide transition (matches kitchen project gallery)
      options.spaceBetween = 0;
    } else {
      // Desktop: fade transition with navigation buttons
      options.effect = 'fade';
      options.speed = 1000;
      options.spaceBetween = 10;
      options.navigation = {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      };
    }

    new Swiper(swiperEl, options);
  }

  function initAccordionScript(root) {
    const scope = root || document;
    const accordionScript = scope.querySelector("#dropdown-accordion-script");
    const accordionScriptSrc = {{ 'accordion-script.js' | asset_url | json }};
    if (!accordionScript) return;

    loadScriptOnce(accordionScriptSrc, "accordion-script", () => {
      if (typeof window.initAccordion === "function") {
        window.initAccordion(scope);
      } else {
        console.warn("initAccordion() is not available");
      }
    });
    return;
  }

  function readmoreDescription() {
    // Configuration
    var charLimit = {{ product.metafields.custom.read_more_height.value | default: 220 }};              // show dropdown only if chars > 700
    var defaultMaxPx = 80;          // collapse height when charLimit exceeded (between 350-400)
    var transitionDuration = 350;    // ms, match your CSS transition

    // Simple debounce
    function debounce(fn, wait) {
      var t;
      return function () {
        var args = arguments;
        clearTimeout(t);
        t = setTimeout(function () { fn.apply(null, args); }, wait);
      };
    }

    // Process all wrappers (safe for AJAX-inserted DOM)
    var wrappers = document.querySelectorAll('.product__description-wrapper');

    wrappers.forEach(function (wrapper) {
      var toggleBtn = wrapper.querySelector('.read-more-toggle');
      var description = wrapper.querySelector('.description-content');
      var collapsedOpen = wrapper.querySelector('.product__description');
      var rotateIcon = wrapper.querySelector('.dropdown-arrow');

      // If description missing, ensure toggle hidden and skip
      if (!description) {
        if (toggleBtn) toggleBtn.style.display = 'none';
        if (rotateIcon) rotateIcon.style.display = 'none';
        return;
      }

      // If toggle exists, remove previous listeners by cloning it (clean slate)
      if (toggleBtn) {
        var cleanButton = toggleBtn.cloneNode(true);
        toggleBtn.parentNode.replaceChild(cleanButton, toggleBtn);
        toggleBtn = cleanButton;
      } else {
        // If no button in markup, create one so aria and show/hide can be applied consistently
        toggleBtn = document.createElement('button');
        toggleBtn.type = 'button';
        toggleBtn.className = 'read-more-toggle';
        toggleBtn.textContent = 'Read More';
        toggleBtn.setAttribute('aria-expanded', 'false');
        // place after description wrapper content
        wrapper.appendChild(toggleBtn);
      }

      // Ensure aria attribute exists
      toggleBtn.setAttribute('aria-expanded', 'false');

      // Normalize classes to a predictable starting state
      description.classList.remove('expanded', 'collapsed-expanded');
      description.classList.add('collapsed');
      if (collapsedOpen) {
        collapsedOpen.classList.remove('collapsed-expanded');
        collapsedOpen.classList.add('collapsed-open');
      }

      // Count letters/characters (trim excessive whitespace)
      var text = (description.textContent || '').replace(/\s+/g, ' ').trim();
      var charCount = text.length;

      // Determine threshold px: prefer data-maxheight-px -> data-maxheight-desktop/mobile -> default
      function getConfiguredPx() {
        var dataPx = description.getAttribute('data-maxheight-px');
        if (dataPx) {
          var n = parseInt(dataPx, 10);
          if (!isNaN(n)) return n;
        }
        // Respect responsive data attributes you already might have
        if (window.matchMedia('(max-width: 590px)').matches) {
          var mobile = description.getAttribute('data-maxheight-mobile');
          if (mobile) {
            var m = parseInt(mobile, 10);
            if (!isNaN(m)) return m;
          }
        } else {
          var desktop = description.getAttribute('data-maxheight-desktop');
          if (desktop) {
            var d = parseInt(desktop, 10);
            if (!isNaN(d)) return d;
          }
        }
        return defaultMaxPx;
      }

      // If character count is under or equal to limit -> show full content and hide toggle
      function showFullNoToggle() {
        toggleBtn.style.display = 'none';
        if (rotateIcon) rotateIcon.style.display = 'none';

        description.classList.remove('collapsed', 'collapsed-by-js', 'expanded');
        description.style.maxHeight = 'none';
        description.style.overflow = 'visible';
        if (collapsedOpen) {
          collapsedOpen.classList.remove('collapsed-open', 'collapsed-expanded');
        }
        toggleBtn.setAttribute('aria-expanded', 'true');
      }

      // If over limit, we'll apply the collapse behaviour
      function setupCollapsedMode() {
        var px = getConfiguredPx();

        toggleBtn.style.display = '';
        if (rotateIcon) rotateIcon.style.display = '';

        // Start collapsed
        description.classList.add('collapsed', 'collapsed-by-js');
        description.classList.remove('expanded', 'collapsed-expanded');
        description.style.overflow = 'hidden';
        description.style.maxHeight = px + 'px';
        if (collapsedOpen) {
          collapsedOpen.classList.add('collapsed-open');
          collapsedOpen.classList.remove('collapsed-expanded');
        }
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.textContent = 'Read More';
        if (rotateIcon) rotateIcon.classList.remove('icon_rotate');
      }

      // Toggle handler (expand/collapse with smooth max-height animation)
      toggleBtn.addEventListener('click', function () {
        var px = getConfiguredPx();

        if (!description.classList.contains('expanded')) {
          // expand
          description.classList.add('expanded');
          description.classList.remove('collapsed');
          if (collapsedOpen) {
            collapsedOpen.classList.add('collapsed-expanded');
            collapsedOpen.classList.remove('collapsed-open');
          }

          // animate to full height then remove max-height after transition
          var fullH = description.scrollHeight;
          description.style.maxHeight = fullH + 'px';
          description.style.overflow = 'hidden';
          toggleBtn.setAttribute('aria-expanded', 'true');
          toggleBtn.textContent = 'Read Less';
          if (rotateIcon) rotateIcon.classList.add('icon_rotate');

          setTimeout(function () {
            if (description.classList.contains('expanded')) {
              description.style.maxHeight = 'none';
              description.style.overflow = 'visible';
            }
          }, transitionDuration + 20);
        } else {
          // collapse
          // set current height explicitly (helps smooth animation), force reflow, then set to px threshold
          description.style.maxHeight = description.scrollHeight + 'px';
          void description.offsetHeight; // force reflow
          description.classList.remove('expanded');
          description.classList.add('collapsed');
          if (collapsedOpen) {
            collapsedOpen.classList.remove('collapsed-expanded');
            collapsedOpen.classList.add('collapsed-open');
          }
          description.style.overflow = 'hidden';
          description.style.maxHeight = px + 'px';
          toggleBtn.setAttribute('aria-expanded', 'false');
          toggleBtn.textContent = 'Read More';
          if (rotateIcon) rotateIcon.classList.remove('icon_rotate');
        }
      });

      // On image load / font change, re-evaluate if we should show toggle or not
      var imgs = description.querySelectorAll('img');
      imgs.forEach(function (img) {
        if (!img.complete) {
          img.addEventListener('load', function () {
            // Re-evaluate mode based on char count (char count won't change, but height might)
            // If chars <= limit we already show full content; if > limit ensure collapsed mode remains correct
            if (charCount <= charLimit) {
              showFullNoToggle();
            } else {
              // If currently expanded, ensure it remains expanded and grows if necessary
              if (description.classList.contains('expanded')) {
                description.style.maxHeight = description.scrollHeight + 'px';
                setTimeout(function () {
                  description.style.maxHeight = 'none';
                  description.style.overflow = 'visible';
                }, transitionDuration);
              } else {
                // collapsed state should keep threshold px
                description.style.maxHeight = getConfiguredPx() + 'px';
              }
            }
          });
        }
      });

      // Recalculate on resize (debounced). Note: charCount threshold is static; this mostly adjusts px threshold for responsive attrs
      var debouncedResize = debounce(function () {
        // If charCount <= limit -> ensure full
        if (charCount <= charLimit) {
          showFullNoToggle();
        } else {
          // reapply collapsed/expanded visuals correctly depending on current state
          if (description.classList.contains('expanded')) {
            // keep expanded but ensure height resets to content
            description.style.maxHeight = description.scrollHeight + 'px';
            setTimeout(function () {
              if (description.classList.contains('expanded')) {
                description.style.maxHeight = 'none';
                description.style.overflow = 'visible';
              }
            }, transitionDuration);
            toggleBtn.setAttribute('aria-expanded', 'true');
            toggleBtn.textContent = 'Read Less';
            if (rotateIcon) rotateIcon.classList.add('icon_rotate');
          } else {
            // collapsed state
            description.style.maxHeight = getConfiguredPx() + 'px';
            description.style.overflow = 'hidden';
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.textContent = 'Read More';
            if (rotateIcon) rotateIcon.classList.remove('icon_rotate');
          }
        }
      }, 180);

      window.addEventListener('resize', debouncedResize);

      // Initial decision
      if (charCount <= charLimit) {
        showFullNoToggle();
      } else {
        setupCollapsedMode();
      }
    });
  }

  // stoq app - show pop up notification on submit:
  setTimeout(function stoqSuccess() {
    const stoqBtn = document.getElementById('form-Button');
    if (!stoqBtn) return;
    stoqBtn.addEventListener('click', () => {
      setTimeout(()=> {
        const success = document.getElementById('form-Success-Content');
        const popupContainer = document.getElementById('cart-popup-container');
        const popupDiv = document.getElementById('cart-notification');
        const popup = document.querySelector('#cart-popup-container .added-message');
        if (success) {
          popup.innerHTML = "Thank you, we'll send you a message as soon as it is back in stock.";
          popupContainer.classList.add("show");
          popupDiv.classList.add("active", "animate");
        }
      },1000);
    });
  }, 1000);
  stoqSuccess();
});
</script>

