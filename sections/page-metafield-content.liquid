    {% if selected_products_6 != blank and quantities_6 != blank %}
      {% for product in selected_products_6 %}
        {% assign index = forloop.index0 %}
        {% assign quantity = quantities_6[index] %}
        {% assign line_total = product.price | times: quantity %}
        {% assign total_line_price_6 = total_line_price_6 | plus: line_total %}
      {% endfor %}
    {% endif %}

    {% assign grand_total = total_line_price_1
      | plus: total_line_price_2
      | plus: total_line_price_3
      | plus: total_line_price_4
      | plus: total_line_price_5
      | plus: total_line_price_6
    %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-metafield-content card__slider-gallery {{ section.settings.sectionname }} color-{{ section.settings.color_scheme }} gradient">
  <div
    class="card__slider-gallery-wrapper page-width section-{{ section.id }}-padding {% if section.settings.show_bottom_border %}bottom__section-border{% endif %}{% if section.settings.show_top_border %} top__section-border{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {% if section.settings.show_page_title %}
      {%- unless page.title == blank -%}
        <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ page.title }}
          </h2>
        {% if section.settings.show_page_cupboard_costs and grand_total > 0 %}
        <div class="page_cupboard_costs">
          Total Cupboard Cost: {{ grand_total | money }}
        </div>
        {% elsif page.metafields.custom.short_description != blank %}
          <div class="page_cupboard_costs">
            {{ page.metafields.custom.short_description }}
          </div>
        {% endif %}
        </div>
      {%- endunless -%}
    {% endif %}

    {% if section.settings.show_page_description %}
      {%- unless page.content == blank -%}
        <div class="page_description">{{ page.content }}</div>
      {%- endunless -%}
    {% endif %}
    <div class="grid grid--1-col grid--2-col-tablet collapsible-content__grid{% if section.settings.desktop_layout == 'image_second' %} collapsible-content__grid--reverse{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="grid__item collapsible-content__grid-item">
          <div
            class="collapsible-content__media collapsible-content__media--{{ section.settings.image_ratio }} media global-media-settings gradient"
            {% if section.settings.image_ratio == 'adapt' %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- liquid
              assign padding_multiplier = 1
              if section.settings.layout == 'section'
                assign padding_multiplier = 2
              endif
              assign desktop_tablet_padding = 100 | times: padding_multiplier | append: 'px'
              assign mobile_padding = 30 | times: padding_multiplier | append: 'px'
            -%}
            {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ desktop_tablet_padding }}) / 2),
                  (min-width: 750px) calc((100vw - {{ desktop_tablet_padding }}) / 2),
                  calc(100vw - {{ mobile_padding }})
                {%- endcapture -%}
            {{
              section.settings.image
              | image_url: width: 3200
              | image_tag:
                sizes: sizes,
                widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
            }}
          </div>
        </div>
      {% endif %}
      {%- comment -%}
        US store: hide the "Breakdown of cupboard costs" accordion on kitchen
        project pages. Prices and product SKUs don't translate 1:1 to the US
        store yet. UK store (master) keeps this block enabled.
      {%- endcomment -%}
      {% if false %}
      <div class="page-collapsible custom-collapsible-content support_custom_collapsible">
        <div
          class="accordion{% if section.settings.layout == 'row' %} content-container color-{{ section.settings.container_color_scheme }} gradient{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div
            class="class-details"
            id="Details-{{ block.id }}-{{ section.id }}"
            {% if section.settings.open_first_collapsible_row and forloop.first %}
              open
            {% endif %}
          >
            {% if page.metafields.custom.breakdown_costs.value != blank %}
              <div class="class-summary" id="Summary-{{ block.id }}-{{ section.id }}">
                {% render 'icon-accordion', icon: block.settings.icon %}
                <div class="title_arrow-wrapper">
                  <h3 class="accordion__title inline-richtext hxl">
                    {{ page.metafields.custom.breakdown_costs.value | escape }}
                  </h3>
                  <span class="dropdown-arrow"></span>
                </div>
                {% if block.settings.sub_heading != blank %}
                  <span class="accordion_sub_heading gill-sans-nova">
                    {{ block.settings.sub_heading | default: block.settings.page.title | escape }}
                  </span>
                {% endif %}
              </div>
            {% endif %}
            <div class="accordion__content-wrapper">
              <div
                class="accordion__content rte"
                id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                role="region"
                aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
              >
                <div class="grid grid--1-col-tablet-down grid--2-col-desktop">
                  <div class="grid__item table_content">
                    <p>{{ page.metafields.custom.section_name_1.value }}</p>

                    {% assign selected_products = page.metafields.custom.product_1.value %}
                    {% assign quantities = page.metafields.custom.quantity_1.value %}

                    {% if selected_products != blank and quantities != blank %}
                      <ul>
                        {% assign total_line_price_1 = 0 %}
                        {% for product in selected_products %}
                          {% assign index = forloop.index0 %}
                          {% assign quantity = quantities[index] %}
                          {% assign line_total = product.price | times: quantity %}
                          {% assign total_line_price_1 = total_line_price_1 | plus: line_total %}
                          <li>
                            <span>{{ quantity }} x {{ product.title }}</span>
                            <span>{{ line_total | money }}</span>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    <p>{{ page.metafields.custom.section_name_2.value }}</p>

                    {% assign selected_products = page.metafields.custom.product_2.value %}
                    {% assign quantities = page.metafields.custom.quantity_2.value %}

                    {% if selected_products != blank and quantities != blank %}
                      <ul>
                        {% assign total_line_price_2 = 0 %}
                        {% for product in selected_products %}
                          {% assign index = forloop.index0 %}
                          {% assign quantity = quantities[index] %}
                          {% assign line_total = product.price | times: quantity %}
                          {% assign total_line_price_2 = total_line_price_2 | plus: line_total %}
                          <li>
                            <span>{{ quantity }} x {{ product.title }}</span>
                            <span>{{ line_total | money }}</span>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    <p>{{ page.metafields.custom.section_name_3.value }}</p>

                    {% assign selected_products = page.metafields.custom.product_3.value %}
                    {% assign quantities = page.metafields.custom.quantity_3.value %}

                    {% if selected_products != blank and quantities != blank %}
                      <ul>
                        {% assign total_line_price_3 = 0 %}
                        {% for product in selected_products %}
                          {% assign index = forloop.index0 %}
                          {% assign quantity = quantities[index] %}
                          {% assign line_total = product.price | times: quantity %}
                          {% assign total_line_price_3 = total_line_price_3 | plus: line_total %}
                          <li>
                            <span>{{ quantity }} x {{ product.title }}</span>
                            <span>{{ line_total | money }}</span>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    <p>{{ page.metafields.custom.section_name_4.value }}</p>

                    {% assign selected_products = page.metafields.custom.product_4.value %}
                    {% assign quantities = page.metafields.custom.quantity_4.value %}

                    {% if selected_products != blank and quantities != blank %}
                      <ul>
                        {% assign total_line_price_4 = 0 %}
                        {% for product in selected_products %}
                          {% assign index = forloop.index0 %}
                          {% assign quantity = quantities[index] %}
                          {% assign line_total = product.price | times: quantity %}
                          {% assign total_line_price_4 = total_line_price_4 | plus: line_total %}
                          <li>
                            <span>{{ quantity }} x {{ product.title }}</span>
                            <span>{{ line_total | money }}</span>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    <p>{{ page.metafields.custom.section_name_5.value }}</p>

                    {% assign selected_products = page.metafields.custom.product_5.value %}
                    {% assign quantities = page.metafields.custom.quantity_5.value %}

                    {% if selected_products != blank and quantities != blank %}
                      <ul>
                        {% assign total_line_price_5 = 0 %}
                        {% for product in selected_products %}
                          {% assign index = forloop.index0 %}
                          {% assign quantity = quantities[index] %}
                          {% assign line_total = product.price | times: quantity %}
                          {% assign total_line_price_5 = total_line_price_5 | plus: line_total %}
                          <li>
                            <span>{{ quantity }} x {{ product.title }}</span>
                            <span>{{ line_total | money }}</span>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    <p>{{ page.metafields.custom.section_name_6.value }}</p>

                    {% assign selected_products = page.metafields.custom.product_6.value %}
                    {% assign quantities = page.metafields.custom.quantity_6.value %}

                    {% if selected_products != blank and quantities != blank %}
                      <ul>
                        {% assign total_line_price_6 = 0 %}
                        {% for product in selected_products %}
                          {% assign index = forloop.index0 %}
                          {% assign quantity = quantities[index] %}
                          {% assign line_total = product.price | times: quantity %}
                          {% assign total_line_price_6 = total_line_price_6 | plus: line_total %}
                          <li>
                            <span>{{ quantity }} x {{ product.title }}</span>
                            <span>{{ line_total | money }}</span>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}

                    {% assign grand_total = total_line_price_1
                      | plus: total_line_price_2
                      | plus: total_line_price_3
                      | plus: total_line_price_4
                      | plus: total_line_price_5
                      | plus: total_line_price_6
                    %}

                    <div class="total_cupboard_costs">
                      <span>Total Cupboard Cost:</span>
                      <span>{{ grand_total | money }}</span>
                    </div>
                  </div>
                  <div class="grid__item raw_content">
                    {{ page.metafields.custom.breakdown_cupboard_raw_content.value }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      {% endif %}
    </div>
    {%- comment -%}
      US store: separator in place of the hidden "Breakdown of cupboard costs"
      accordion, so the page keeps a clear visual break before the next section.
    {%- endcomment -%}
    <hr class="us-breakdown-hidden-separator" style="border:0;border-top:1px solid #e5e5e5;margin:35px 0 10px;">
  </div>
</div>

<script>
  var swiper = new Swiper(".mySwiper", {
    slidesPerView: 5,
    spaceBetween: 24,
    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },
    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },
  });
</script>

{% schema %}
{
  "name": "Page metafield content",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_page_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "checkbox",
      "id": "show_page_cupboard_costs",
      "label": "Show page cupboard costs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_page_description",
      "label": "Show page description",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
