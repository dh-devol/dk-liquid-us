        {% assign index = forloop.index0 %}
        {% assign quantity = quantities_4[index] %}
        {% assign line_total = product.price | times: quantity %}
        {% assign total_line_price_4 = total_line_price_4 | plus: line_total %}
      {% endfor %}
    {% endif %}

    {% assign selected_products_5 = page.metafields.custom.product_5.value %}
    {% assign quantities_5 = page.metafields.custom.quantity_5.value %}
    {% assign total_line_price_5 = 0 %}
    {% if selected_products_5 != blank and quantities_5 != blank %}
      {% for product in selected_products_5 %}
        {% assign index = forloop.index0 %}
