{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .catalogue__content-wrapper{
    margin-top:38px;
  }
  .catalogue__content-wrapper a{
    color:#595959;
    text-decoration:none;
    font-weight:500;
  }
  @media screen and (max-width:767px){
    .press-catalogue iframe{
      height:100%;
    }
  }
{%- endstyle -%}


<div class="press-catalogue color-{{ section.settings.color_scheme }} gradient">
  <div class="press-catalogue-wrapper page-width section-{{ section.id }}-padding {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
     {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}>
    {% if article.metafields.custom.your_catalogue != blank %}
    <div class="iframe__catalogue-wrapper">
      <iframe 
          src="https://view.publitas.com/devol-kitchens/{{ article.metafields.custom.your_catalogue }}" 
          width="100%" 
          height="600px" 
          style="border: none;">
      </iframe>
    </div>
    {% endif %}
    {% assign catalogue_meta = article.metafields.custom.catalogue_link_metaobject.value %}
    {% assign catalogue_link = blank %}
    {% assign catalogue_text = blank %}
    {% if catalogue_meta != blank %}
      {% assign link_field = catalogue_meta.name_and_url %}
      {% if link_field != blank %}
        {% assign catalogue_link = link_field.url | default: link_field.value.url | default: link_field.value %}
        {% assign catalogue_text = link_field.text | default: link_field.value.text %}
      {% endif %}
    {% endif %}
    {% if catalogue_link == blank and article.metafields.custom.catalogue_link != blank %}
      {% assign catalogue_link = article.metafields.custom.catalogue_link %}
      {% assign catalogue_text = article.metafields.custom.catalogue_title %}
    {% endif %}
    {% if catalogue_link != blank %}
      <div class="catalogue__content-wrapper center">
        <a target="_blank" class="hxl" href="{{ catalogue_link }}">{{ catalogue_text }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Press Catalogue",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Press Catalogue"
    }
  ]
}
{% endschema %}
