{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    padding-left: 0;
    padding-right: 0;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false
  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="custom-multicolumn {{ section.settings.sectionname }} multicolumn color-{{ section.settings.color_scheme }} gradient{% unless section.settings.background_style == 'none' and settings.text_boxes_border_thickness > 0 or settings.text_boxes_shadow_opacity > 0 %} background-{{ section.settings.background_style }}{% endunless %}{% if section.settings.title == blank %} no-heading{% endif %}">
  <div
    class="page-width section-{{ section.id }}-padding {% if section.settings.show_bottom_border %}bottom__section-border{% endif %}{% if section.settings.show_top_border %} top__section-border{% endif %} isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- unless section.settings.title == blank -%}
      <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      </div> 
    {%- endunless -%}
    {% if section.settings.subtitle != blank %}
      <div class="subtitle__wrapper {% if section.settings.title != blank %}above__margin{% endif %}">
        <h3 class="sub-heading hxl">{{ section.settings.subtitle }}</h3>
        {%- if section.settings.button_label != blank -%} 
          <a href="{{ section.settings.button_link }}" class="sub_heading--link">
            {{- section.settings.button_label | escape -}}<span> ></span>
          </a>
        {%- endif -%}
      </div>
    {% endif %}
    <slider-component class="slider-mobile-gutter">
      <ul
        class="multicolumn-list contains-content-container grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop{% if show_mobile_slider %} slider slider--tablet grid--peek{% endif %}"
        id="Slider-{{ section.id }}"
        role="list"
      >
        {%- liquid
          assign highest_ratio = 0

          for block in section.blocks
            assign ratio_image = nil

            if block.settings.link != blank
              assign link_clean = block.settings.link | remove: 'https://' | remove: 'http://'
              assign link_parts = link_clean | split: '/'
              assign page_handle = link_parts | last
              assign page_from_link = pages[page_handle]

              if page_from_link and page_from_link.metafields.custom.features_image != blank
                assign ratio_image = page_from_link.metafields.custom.features_image
              endif
            endif

            if ratio_image == nil and block.settings.image != blank
              assign ratio_image = block.settings.image
            endif

            if ratio_image != nil and ratio_image.aspect_ratio > highest_ratio
              assign highest_ratio = ratio_image.aspect_ratio
            endif
          endfor
        -%}

        {%- for block in section.blocks -%}
          {%- liquid
            assign empty_column = ''

            comment
              Build selected_page from the block link
            endcomment
            assign selected_page = nil
            if block.settings.link != blank
              assign link_clean = block.settings.link | remove: 'https://' | remove: 'http://'
              assign link_parts = link_clean | split: '/'
              assign page_handle = link_parts | last
              assign selected_page = pages[page_handle]
            endif

            comment
              Decide which image to show:
              1) Page metafield custom.features_image
              2) Fallback to block.settings.image
            endcomment
            assign selected_image = nil
            if selected_page and selected_page.metafields.custom.features_image != blank
              assign selected_image = selected_page.metafields.custom.features_image
            elsif block.settings.image != blank
              assign selected_image = block.settings.image
            endif

            comment
              Column considered empty only if no image, no title (page/block), and no text/meta
            endcomment
            assign has_title = false
            if selected_page and selected_page.title != blank
              assign has_title = true
            elsif block.settings.title != blank
              assign has_title = true
            endif

            assign has_content = false
            if selected_page and selected_page.content != blank
              assign has_content = true
            endif
          -%}

          <li
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            class="multicolumn-list__item grid__item{% if section.settings.swipe_on_mobile %} slider__slide{% endif %}{% if section.settings.column_alignment == 'center' %} center{% endif %}{{ empty_column }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <div class="multicolumn-card content-container">
              {% comment %}
                DESCRIPTION ABOVE IMAGE (now using page content + showroom metafields)
              {% endcomment %}
              {%- capture showroom_text -%}
                {% if selected_page %}
                  {% liquid
                    assign page_content = selected_page.content
                    if template contains 'page' and selected_page.metafields.custom.short_description != blank
                      assign page_content = selected_page.metafields.custom.short_description
                    endif
                  %}
                  {%- if section.settings.show_description and page_content != blank -%}
                    <div class="showroom__description rte">
                      {{ page_content }}
                    </div>
                  {%- endif -%}
                  {% if page.handle contains "showrooms" %}
                    <p class="lght">___</p>
                  {% endif %}
                  {%- assign order_raw = section.settings.showroom_order | default: 'additional,address,timing' -%}
                  {%- assign order_list = order_raw | split: ',' -%}

                  {%- for part in order_list -%}
                    {%- assign part_key = part | strip -%}

                    {%- case part_key -%}

                      {%- when 'additional' -%}
                        {%- if selected_page.metafields.custom.showroom_additional_note != blank -%}
                          <div class="showroom__note rte">
                            {{ selected_page.metafields.custom.showroom_additional_note | metafield_tag }}
                          </div>
                        {%- endif -%}

                      {%- when 'address' -%}
                        {%- unless template contains 'kitchen-enquiries' -%}
                          {%- if selected_page.metafields.custom.showroom_address != blank -%}
                            <div class="showroom_list_item showroom__address rte">
                              {{ selected_page.metafields.custom.showroom_address | metafield_tag }}
                              {{ selected_page.metafields.custom.showroom_phone | metafield_tag }}
                              {{ selected_page.metafields.custom.showroom_email | metafield_tag }}
                            </div>
                          {%- endif -%}
                        {%- else -%}
                          {%- if selected_page.metafields.custom.showroom_phone != blank -%}
                            <div class="showroom__address rte">
                              {{ selected_page.metafields.custom.showroom_phone | metafield_tag }}
                            </div>
                          {%- endif -%}
                          {%- if selected_page.metafields.custom.showroom_email != blank -%}
                            <div class="showroom__email rte">
                              {{ selected_page.metafields.custom.showroom_email | metafield_tag }}
                            </div>
                          {%- endif -%}
                          <p class="lght">___</p>
                          {%- if selected_page.metafields.custom.showroom_address != blank -%}
                            <div class="showroom__address rte">
                              {{ selected_page.metafields.custom.showroom_address | metafield_tag }}
                            </div>
                          {%- endif -%}
                        {%- endunless -%}
                        

                        

                      {%- when 'timing' -%}
                        {%- if selected_page.metafields.custom.showroom_timing != blank -%}
                          <div class="showroom__timing rte">
                            {{ selected_page.metafields.custom.showroom_timing | metafield_tag }}
                          </div>
                        {%- endif -%}

                    {%- endcase -%}
                  {%- endfor -%}
                {% endif %}
              {%- endcapture -%}

              {% if block.settings.show_above_image %}
                {% if block.settings.text != blank %}
                  <div class="description_above--image">
                    <div class="rte">{{ block.settings.text }}</div>
                  </div>
                {% elsif showroom_text != blank %}
                  <div class="description_above--image">
                    <div class="rte">{{ showroom_text }}</div>
                  </div>
                {% endif %}
              {% endif %}


              {%- if selected_image != nil -%}
                {% if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle' %}
                  {% assign spaced_image = true %}
                {% endif %}
                <a href="{{ block.settings.link }}" class="multicolumn-card__image-wrapper {% if block.settings.custom_text_hover != blank %}text__hover{% endif %} {% if block.settings.image_hover != blank or block.settings.custom_text_hover != blank %}hover__image-wrapper{% endif %} multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}">
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}" 
                    {% if section.settings.image_ratio == 'adapt' and highest_ratio > 0 %}
                      style="padding-bottom: {{ 1 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {%- liquid
                      assign number_of_columns = section.settings.columns_desktop
                      assign number_of_columns_mobile = section.settings.columns_mobile
                      assign grid_space_desktop = number_of_columns | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_tablet = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | plus: 100 | append: 'px'
                      assign grid_space_mobile = number_of_columns_mobile | minus: 1 | times: settings.spacing_grid_horizontal | divided_by: 2 | plus: 30 | append: 'px'
                      if section.settings.image_width == 'half'
                        assign image_width = 0.5
                      elsif section.settings.image_width == 'third'
                        assign image_width = 0.33
                      else
                        assign image_width = 1
                      endif
                    -%}
                    {% capture sizes %}
                      (min-width: {{ settings.page_width }}px) calc(({{ settings.page_width }}px - {{ grid_space_desktop }}) * {{ image_width }} /  {{ number_of_columns }}),
                      (min-width: 990px) calc((100vw - {{ grid_space_desktop }}) * {{ image_width }} / {{ number_of_columns }}),
                      (min-width: 750px) calc((100vw - {{ grid_space_tablet }}) * {{ image_width }} / {{ number_of_columns_mobile }}),
                      calc((100vw - {{ grid_space_mobile }}) * {{ image_width }} / {{ number_of_columns_mobile }})
                    {% endcapture %}
                    {{
                      selected_image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '900, 1000, 1250, 1550, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                        sizes: sizes,
                        class: 'multicolumn-card__image standard__image'
                    }}
                    {% unless block.settings.custom_text_hover != blank %}
                      {% if block.settings.image_hover != blank %} 
                        {{
                          block.settings.image_hover
                          | image_url: width: 3200
                          | image_tag:
                            widths: '900, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200',
                            sizes: sizes,
                            class: 'multicolumn-card__image hover__image'
                        }}
                      {% endif %}
                    {% else %}
                      <div class="multicolumn-card__image hover__image custom__text--on-hover">
                        <div class="inner__hover-shadow">{{ block.settings.custom_text_hover }}</div>
                      </div>
                    {% endunless %}
                  </div>
                </a>
              {%- endif -%}

              <div class="multicolumn-card__info">
                {%- liquid
                  assign card_title = ''
                  if selected_page and selected_page.title != blank
                    assign card_title = selected_page.title
                  elsif block.settings.title != blank
                    assign card_title = block.settings.title
                  endif
                -%}

                {%- if card_title != blank -%}
                  <h3 class="inline-richtext">
                    <a href="{{ block.settings.link }}">{{ card_title }}</a>
                  </h3>
                {%- endif -%}

                {%- if block.settings.subtext != blank -%}
                  <p class="inline-richtext sub-text">
                    <a href="{{ block.settings.link }}">{{ block.settings.subtext }}</a>
                  </p>
                {%- endif -%}

                {%- unless block.settings.show_above_image -%}
                  {% if block.settings.text != blank %}
                    <div class="rte">{{ block.settings.text }}</div>
                  {% elsif showroom_text != blank %}
                    <div class="rte">{{ showroom_text }}</div>
                  {% endif %}
                {%- endunless -%}


                {%- if block.settings.link_label != blank -%}
                  <a
                    class="link animate-arrow"
                    {% if block.settings.link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.link }}"
                    {% endif %}
                  >
                    {{- block.settings.link_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if show_mobile_slider -%}
        <div class="slider-buttons large-up-hide">
          <button
            type="button"
            class="slider-button slider-button--prev"
            name="previous"
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button
            type="button"
            class="slider-button slider-button--next"
            name="next"
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
          </button>
        </div>
      {%- endif -%}
    </slider-component>
  </div>
</div>

{% schema %}
{
  "name": "Showroom multicolumn",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Sub heading"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show page description",
      "default": true
    },
    {
      "type": "text",
      "id": "showroom_order",
      "label": "Showroom content order",
      "info": "Use comma-separated values with any order, e.g. 'additional,address,timing' or 'timing,address,additional'.",
      "default": "additional,address,timing"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "t:sections.multicolumn.settings.background_style.options__2.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.multicolumn.settings.background_style.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.multicolumn.settings.button_label.default",
      "label": "t:sections.multicolumn.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": false,
      "label": "t:sections.multicolumn.settings.swipe_on_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "For developer use"
    },
    {
      "type": "text",
      "id": "sectionname",
      "label": "Do not edit"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label",
          "info": "Link the page to the showroom, and all content will load dynamically from the page details."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "image_picker",
          "id": "image_hover",
          "label": "Image",
          "info": "Appear on hover with an animation"
        },
        {
          "type": "richtext",
          "id": "custom_text_hover",
          "label": "Hover text",
          "info": "If it's not blank, it appears on hover. Use line breaks to split text across lines."
        },
        {
          "type": "inline_richtext",
          "id": "title",
          "default": "t:sections.multicolumn.blocks.column.settings.title.default",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label"
        },
        {
          "type": "inline_richtext",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.multicolumn.blocks.column.settings.text.default",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label"
        },
        {
          "type": "checkbox",
          "id": "show_above_image",
          "label": "Show description above image",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Showroom multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
