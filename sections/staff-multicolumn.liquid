{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'section-custom-multicolumn.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'collapsible-content.css' | asset_url | stylesheet_tag }}
{{ 'custom-collapsible-content.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{%- assign staff_entries = page.metafields.custom.staff.value -%}
{%- paginate page.metafields.custom.staff.value by 250 -%}

  {%- liquid
    assign section_heading = section.settings.subtitle | strip_html | strip | downcase
    assign columns_desktop = section.settings.columns_desktop | plus: 0
    assign matching_staff_count = 0
    assign visible_staff_index = 0
    assign highest_ratio = 0

    for person in staff_entries
      assign person_heading = person.heading.value | strip | downcase

      if section_heading != blank and person_heading == section_heading
        assign matching_staff_count = matching_staff_count | plus: 1
        assign person_image = person.image.value

        if person_image.aspect_ratio > highest_ratio
          assign highest_ratio = person_image.aspect_ratio
        endif
      endif
    endfor

    assign highest_ratio = highest_ratio | default: 1
  -%}

  <div class="custom-collapsible-content staff-multicolumn custom-multicolumn {{ section.settings.sectionname }} multicolumn color-{{ section.settings.color_scheme }} gradient background-{{ section.settings.background_style }}{% if section.settings.title == blank %} no-heading{% endif %}">
    <div class="page-width section-{{ section.id }}-padding isolate{% if section.settings.show_bottom_border %} bottom__section-border{% endif %}{% if section.settings.show_top_border %} top__section-border{% endif %}">

      {% if section.settings.title != blank %}
        <div class="title-wrapper-with-link title-wrapper--self-padded-mobile title-wrapper--no-top-margin multicolumn__title">
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        </div>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <div class="subtitle__wrapper{% if section.settings.title != blank %} above__margin{% endif %}">
          <h3 class="sub-heading hxl">{{ section.settings.subtitle }}</h3>

          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link }}" class="sub_heading--link">
              {{ section.settings.button_label | escape }}<span> &gt;</span>
            </a>
          {% endif %}
        </div>
      {% endif %}

      <div class="multicolumn-list contains-content-container">
        {% for person in staff_entries %}
          {%- liquid
            assign person_heading = person.heading.value | strip | downcase

            if section_heading == blank or person_heading != section_heading
              continue
            endif

            assign staff_image = person.image.value
            assign staff_name = person.name.value
            assign staff_role = person.role.value
            assign staff_degree = person.degree.value
            assign staff_url = person.link.value
            assign staff_url_title = person.link_title.value
            assign modulo_result = visible_staff_index | modulo: columns_desktop
            assign spaced_image = false

            if section.settings.image_ratio == 'adapt' or section.settings.image_ratio == 'circle'
              assign spaced_image = true
            endif
          -%}

          {% capture staff_description %}
            {{ person.description | metafield_tag }}
          {% endcapture %}

          {% if modulo_result == 0 %}
            <div class="staff-row {% if visible_staff_index == 0 %}first{% else %}last{% endif %} grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop">
          {% endif %}

          <div
            id="Staff-{{ section.id }}-{{ person.system.id }}"
            class="multicolumn-list__item grid__item{% if section.settings.column_alignment == 'center' %} center{% endif %}"
          >
            <div class="multicolumn-card content-container">
              {% if staff_image != blank %}
                <a
                  href="#StaffDetails-{{ section.id }}-{{ visible_staff_index | divided_by: columns_desktop }}"
                  class="multicolumn-card__image-wrapper text__hover hover__image-wrapper multicolumn-card__image-wrapper--{{ section.settings.image_width }}-width{% if section.settings.image_width != 'full' or spaced_image %} multicolumn-card-spacing{% endif %}"
                  aria-label="{{ staff_name | escape }}"
                  data-name="{{ staff_name | escape }}"
                  data-role="{{ staff_role | escape }}"
                  data-degree="{{ staff_degree | escape }}"
                  data-description="{{ staff_description | strip | escape }}"
                  data-image-src="{{ staff_image | image_url: width: 1600 | escape }}"
                  data-image-alt="{{ staff_image.alt | default: staff_name | escape }}"
                  data-url-path="{{ staff_url | escape }}"
                  data-url-title="{{ staff_url_title | escape }}"
                >
                  <div
                    class="media media--transparent media--{{ section.settings.image_ratio }}"
                    {% if section.settings.image_ratio == 'adapt' and highest_ratio > 0 %}
                      style="padding-bottom: {{ 1.0 | divided_by: highest_ratio | times: 100 }}%;"
                    {% endif %}
                  >
                    {{
                      staff_image
                      | image_url: width: 3200
                      | image_tag:
                        widths: '375, 550, 750, 900, 1100, 1500, 2000, 3200',
                        sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                        class: 'multicolumn-card__image standard__image',
                        loading: 'lazy'
                    }}

                    <div class="multicolumn-card__image hover__image custom__text--on-hover">
                      <div class="inner__hover-shadow">
                        {% if staff_name != blank %}
                          <h3 class="hxl staff_hover-title">
                            {{ staff_name | escape }}
                          </h3>
                        {% endif %}

                        {% if staff_role != blank %}
                          <span class="staff_hover-role">
                            {{ staff_role | escape }}
                          </span>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </a>
              {% endif %}

              <div class="large-up-hide accordion">
                <div
                  class="class-details"
                  id="Details-{{ section.id }}-{{ person.system.id }}"
                >
                  <div
                    class="class-summary"
                    id="Summary-{{ section.id }}-{{ person.system.id }}"
                  >
                    <div class="title_arrow-wrapper">
                      <h3 class="accordion__title inline-richtext hxl">
                        {{ staff_name | escape }}
                      </h3>
                      <span class="dropdown-arrow"></span>
                    </div>

                    {% if staff_role != blank %}
                      <span class="accordion_sub_heading gill-sans-nova">
                        {{ staff_role | escape }}
                      </span>
                    {% endif %}
                  </div>

                  <div class="accordion__content-wrapper">
                    <div
                      class="accordion__content rte"
                      id="CollapsibleAccordion-{{ section.id }}-{{ person.system.id }}"
                      role="region"
                      aria-labelledby="Summary-{{ section.id }}-{{ person.system.id }}"
                    >
                      {% if staff_degree != blank %}
                        <p class="staff-degree">{{ staff_degree | escape }}</p>
                      {% endif %}

                      {{ staff_description }}

                      {% if staff_url != blank %}
                        <div class="link-wrapper">
                          <a href="{{ staff_url | escape }}">
                            {{ staff_url_title | default: staff_name | escape }}
                          </a>
                        </div>
                      {% endif %}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {% assign visible_staff_index = visible_staff_index | plus: 1 %}
          {% assign row_remainder = visible_staff_index | modulo: columns_desktop %}

          {% if row_remainder == 0 or visible_staff_index == matching_staff_count %}
            <div
              class="staff-detail"
              id="StaffDetails-{{ section.id }}-{{ visible_staff_index | minus: 1 | divided_by: columns_desktop }}"
            >
              <div class="staff__image-wrapper">
                <img class="staff__image" alt="" hidden>
              </div>

              <div class="staff__detail-wrapper">
                <h2 class="staff-name hxl"></h2>
                <p class="staff-role"></p>
                <span class="staff-degree"></span>
                <div class="rte staff-description"></div>
                <div class="staff-url__wrapper">
                  <a class="staff-url" hidden></a>
                </div>
              </div>
            </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Staff multicolumn",
  "class": "section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.multicolumn.settings.title.default",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Sub heading"
    },
    {
      "type": "select",
      "id": "image_width",
      "options": [
        {
          "value": "third",
          "label": "t:sections.multicolumn.settings.image_width.options__1.label"
        },
        {
          "value": "half",
          "label": "t:sections.multicolumn.settings.image_width.options__2.label"
        },
        {
          "value": "full",
          "label": "t:sections.multicolumn.settings.image_width.options__3.label"
        }
      ],
      "default": "full",
      "label": "t:sections.multicolumn.settings.image_width.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.multicolumn.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.multicolumn.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.multicolumn.settings.image_ratio.options__3.label"
        },
        {
          "value": "circle",
          "label": "t:sections.multicolumn.settings.image_ratio.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.multicolumn.settings.image_ratio.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "column_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.multicolumn.settings.column_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.multicolumn.settings.column_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.multicolumn.settings.column_alignment.label"
    },
    {
      "type": "select",
      "id": "background_style",
      "options": [
        {
          "value": "none",
          "label": "t:sections.multicolumn.settings.background_style.options__1.label"
        },
        {
          "value": "primary",
          "label": "t:sections.multicolumn.settings.background_style.options__2.label"
        }
      ],
      "default": "primary",
      "label": "t:sections.multicolumn.settings.background_style.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "t:sections.multicolumn.settings.button_label.default",
      "label": "t:sections.multicolumn.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Show top border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_bottom_border",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.multicolumn.settings.header_mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.multicolumn.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.multicolumn.settings.columns_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "For developer use"
    },
    {
      "type": "text",
      "id": "sectionname",
      "label": "Do not edit"
    }
  ],
  "blocks": [
    {
    "type": "column",
    "name": "Staff column",
    "settings": [
      {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      },
      {
        "type": "inline_richtext",
        "id": "title",
        "label": "Heading"
      },
      {
        "type": "inline_richtext",
        "id": "staff_name",
        "label": "Name"
      },
      {
        "type": "inline_richtext",
        "id": "staff_role",
        "label": "Role"
      },
      {
        "type": "inline_richtext",
        "id": "staff_degree",
        "label": "Degree"
      },
      {
        "type": "richtext",
        "id": "staff_description",
        "label": "Description"
      },
      {
        "type": "text",
        "id": "staff_url_title",
        "label": "Link title"
      },
      {
        "type": "url",
        "id": "staff_url",
        "label": "Link"
      }
    ]
  }
],
  "presets": [
    {
      "name": "Staff multicolumn",
      "blocks": [
        {
          "type": "column"
        },
        {
          "type": "column"
        },
        {
          "type": "column"
        }
      ]
    }
  ]
}
{% endschema %}
