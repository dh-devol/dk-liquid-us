{%- if item.properties['_Added as add-on'] == 'true' and item.properties._group_id != blank -%}
  {% continue %}
{%- endif -%}
{%- if item.properties._bundle_child == 'true' -%}
  {% continue %}
{%- endif -%}

{%- assign _cart_flooring_type = settings.flooring_product_type | default: 'Flooring' -%}
{%- if item.product.type == _cart_flooring_type -%}
  {%- assign _item_tile_type = item.product.metafields.custom.flooring_tile_type.value | downcase -%}
  {%- assign _item_unit_area = item.product.metafields.custom.unit_area_m2.value | plus: 0 -%}
  {%- assign _item_is_fixed_tile = false -%}
  {%- assign _item_show_m2 = false -%}
  {%- if _item_tile_type == 'fixed tile' or _item_tile_type == 'fixed pack' -%}
    {%- assign _item_is_fixed_tile = true -%}
    {%- if _item_unit_area > 0 -%}
      {%- assign _item_m2 = item.quantity | times: _item_unit_area | round: 2 -%}
      {%- assign _item_show_m2 = true -%}
    {%- endif -%}
  {%- elsif _item_tile_type == 'free length' or _item_tile_type == 'variable pack' -%}
    {%- assign _item_m2 = item.quantity -%}
    {%- assign _item_show_m2 = true -%}
  {%- endif -%}
  {%- if _item_show_m2 -%}
    {%- assign _m2_cents = _item_m2 | times: 100 | round -%}
    {%- assign _m2_frac = _m2_cents | modulo: 100 -%}
    {%- assign _m2_frac_str = _m2_frac | prepend: '00' | slice: -2, 2 -%}
    {%- assign _m2_floor = _item_m2 | floor -%}
    {%- assign _item_m2_display = _m2_floor | append: '.' | append: _m2_frac_str -%}
    {%- comment -%} US store: convert m² area to ft² (1 m² = 10.7639 ft²) for the desktop summary line {%- endcomment -%}
    {%- assign _item_ft2 = _item_m2 | times: 10.7639 -%}
    {%- assign _ft2_cents = _item_ft2 | times: 100 | round -%}
    {%- assign _ft2_frac = _ft2_cents | modulo: 100 -%}
    {%- assign _ft2_frac_str = _ft2_frac | prepend: '00' | slice: -2, 2 -%}
    {%- assign _ft2_floor = _item_ft2 | floor -%}
    {%- assign _item_ft2_display = _ft2_floor | append: '.' | append: _ft2_frac_str -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}Resolve cart quantity limit from theme settings{%- endcomment -%}
{%- assign _cart_qty_limit = 0 -%}
{%- assign _cart_qty_limit_tag = '' -%}
{%- assign _per_item_limit = 0 -%}
{%- for i in (1..5) -%}
  {%- assign _tag_key = 'cart_qty_limit_tag_' | append: i -%}
  {%- assign _type_key = 'cart_qty_limit_type_' | append: i -%}
  {%- assign _max_key = 'cart_qty_limit_max_' | append: i -%}
  {%- assign _per_item_key = 'cart_qty_limit_per_item_' | append: i -%}
  {%- assign _limit_tag = settings[_tag_key] -%}
  {%- assign _limit_type = settings[_type_key] -%}
  {%- assign _limit_max = settings[_max_key] | plus: 0 -%}
  {%- assign _limit_per_item = settings[_per_item_key] | plus: 0 -%}
  {%- assign _tag_match = false -%}
  {%- if _limit_tag != blank and item.product.tags contains _limit_tag -%}
    {%- assign _tag_match = true -%}
  {%- endif -%}
  {%- assign _type_match = false -%}
  {%- if _limit_type != blank and item.product.type == _limit_type -%}
    {%- assign _type_match = true -%}
  {%- endif -%}
  {%- if _tag_match or _type_match -%}
    {%- if _limit_max > 0 -%}
      {%- assign _cart_qty_limit = _limit_max -%}
      {%- assign _cart_qty_limit_tag = _limit_tag | default: _limit_type -%}
    {%- endif -%}
    {%- if _limit_per_item > 0 -%}
      {%- assign _per_item_limit = _limit_per_item -%}
    {%- endif -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- assign cart_item_url = item.url -%}
{%- if item.properties._parent_url != blank -%}
  {%- assign cart_item_url = item.properties._parent_url -%}
{%- endif -%}

{% comment %} adding bundle addon and bundle component keys and qty to cart {% endcomment %}
{%- if item.properties['_bundle_parent'] == 'true' -%}
  {%- assign addon_keys = '' -%}
  {%- assign bundle_items = '' -%}
  {%- for ci in cart.items -%}
    {%- if ci.properties['_Added as add-on'] == 'true' and ci.properties._group_id == item.properties._group_id -%}
      {%- if addon_keys == '' -%}
        {%- assign addon_keys = ci.key -%}
      {%- else -%}
        {%- assign addon_keys = addon_keys | append: ci.key | append: ',' -%}
      {%- endif -%}
    {%- endif -%}
    {%- if ci.properties['_bundle_child'] == 'true' and ci.properties._group_id == item.properties._group_id -%}
      {%- assign multiplier = ci.properties._bundle_base_qty | divided_by: item.quantity -%}
      {%- capture row -%}
        {"key": "{{ ci.key }}", "multiplier": "{{ multiplier }}"}
      {%- endcapture -%}
      {%- if bundle_items != '' -%}
        {%- assign bundle_items = bundle_items | append: ',' -%}
      {%- endif -%}
      {%- assign bundle_items = bundle_items | append: row -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<tr class="cart-item" id="CartItem-{{ item.index | plus: 1 }}">
  <td class="cart-item__media">
    {% if item.image %}
      {% comment %} Leave empty space due to a:empty CSS display: none rule {% endcomment %}
      <a href="{{ cart_item_url }}" class="cart-item__link" aria-hidden="true" tabindex="-1"> </a>
      <div class="cart-item__image-container gradient global-media-settings">
        <img
          src="{{ item.image | image_url: width: 300 }}"
          class="cart-item__image"
          alt="{{ item.image.alt | escape }}"
          loading="lazy"
          width="150"
          height="{{ 150 | divided_by: item.image.aspect_ratio | ceil }}"
        >
      </div>
    {% endif %}
  </td>

  <td class="cart-item__details">
    {%- if settings.show_vendor -%}
      <p class="caption-with-letter-spacing">{{ item.product.vendor }}</p>
    {%- endif -%}

    <a href="{{ cart_item_url }}" class="cart-item__name h4 break">
      {% if item.properties._group_id != blank and item.product.title contains "Plate" %}
        {{ item.product.title | escape }}
      {% elsif item.properties._group_id != blank and item.product.metafields.custom.custom_product_title %}
        {{ item.product.metafields.custom.custom_product_title }}
      {% else %}
        {{ item.product.title | escape }}
      {% endif %}
    </a>
  {% comment %}
    {%- if item.original_price != item.final_price -%}
      <div class="cart-item__discounted-prices">
        <span class="visually-hidden">
          {{ 'products.product.price.regular_price' | t }}
        </span>
        <s class="cart-item__old-price product-option">
          {{- item.original_price | money-}}
        </s>
        <span class="visually-hidden">
          {{ 'products.product.price.sale_price' | t }}
        </span>
        <strong class="cart-item__final-price product-option">
          {{ item.final_price | money}}
        </strong>
      </div>
    {%- else -%}
      <div class="product-option">
        {{ item.original_price | money}}
      </div>
    {%- endif -%}
  {% endcomment %}
    {%- if item.product.has_only_default_variant == false
      or item.properties.size != 0
      or item.selling_plan_allocation != null
    -%}
      <dl>
        {%- if item.product.has_only_default_variant == false -%}
          {%- for option in item.options_with_values -%}
            <div class="product-option">
              <dt>{{ option.name }}:</dt>
              <dd>{{ option.value }}</dd>
            </div>
          {%- endfor -%}
        {%- endif -%}

         {%- capture item_lead_time_text -%}
          {%- render 'lead-time-text', product: item.product, variant: item.variant, quantity: item.quantity -%}
        {%- endcapture -%}

        {%- capture item_lead_time_days -%}
          {%- render 'lead-time-text', product: item.product, variant: item.variant, quantity: item.quantity, field: 'lead_time_days' -%}
        {%- endcapture -%}
        {%- assign item_lead_time_days = item_lead_time_days | strip -%}

        {%- assign last_matching_key = "" -%}
        {%- for property in item.properties -%}
          {%- assign key = property.first -%}

          {%- if key contains "Scent" or key contains "Colour" -%}
            {%- assign last_matching_key = key -%}
          {%- endif -%}
        {%- endfor -%}

        {%- for property in item.properties -%}
          {%- assign property_key = property.first -%}
          {%- assign property_value = property.last -%}
          {%- assign property_first_char = property_key | slice: 0 -%}

          {%- if property_key == 'Availability' and item_lead_time_text != blank -%}
            {%- assign property_value = item_lead_time_text -%}
          {%- endif -%}

          {%- if property_value != blank
            and property_first_char != '_'
            and property_key != 'qty-step'
            and property_key != '_qty-step'
          -%}
          
          {% if property_key == "Scent 1" or property_key == "_Colour 1" %}
            <div class="product-option scent">Inc.</div>
          {%- endif -%}
          <div class="product-option{% if property_key contains "Scent" or property_key contains "Colour" %} scent{% endif %}">
            {%- if property_value contains '/uploads/' -%}
              <a href="{{ property_value }}" class="link" target="_blank">
                {{ property_value | split: '/' | last }}
              </a>{% unless property_key == last_matching_key %}, {% endunless %}
            {%- else -%}
              {{ property_value }}
            {%- endif -%}
          </div>
          {%- elsif property_key contains 'Scent' or property_key contains 'Colour' -%}
            {% if property_key == "_Scent 1" or property_key == "_Colour 1"  %}
              <div class="product-option scent">Inc.</div>
            {%- endif -%}
            <div class="product-option{% if property_key contains "Scent" or property_key contains "Colour" %} scent{% endif %}">
              {%- if property_value contains '/uploads/' -%}
                <a href="{{ property_value }}" class="link" target="_blank">
                  {{ property_value | split: '/' | last }}
                </a>{% unless property_key == last_matching_key %},{% endunless %}
              {%- else -%}
                {{ property_value }}{% unless property_key == last_matching_key %},{% endunless %}
              {%- endif -%}
            </div>
          {%- elsif property_key == '_Cart Text' -%}
            <div class="product-option">
              {{ property_value }}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- comment -%}
          Bundle colours rendered IN THE CART from the hidden `_bundle_summary`
          property. Because it's underscore-prefixed it does NOT appear at
          checkout, where the Cart Transform Function already lists the chosen
          components as nested line items. Net: colours show in the cart, but
          aren't duplicated at checkout.
        {%- endcomment -%}
        {%- comment -%} `_bundle_summary` already lists chosen colours (with "(×N)" only when N>1). {%- endcomment -%}
        {% comment %} {%- if item.properties._bundle_summary != blank -%}
          <div class="product-option">Inc. {{ item.properties._bundle_summary | replace: ' • ', ', ' }}</div>
        {%- endif -%} {% endcomment %}
      </dl>
      {% comment %} Fallback {%- assign item_lead_time_days = item_product_lead_time_days | default: item.properties["_lead_time_days"] -%} {% endcomment %}
      {%- if item_lead_time_days != blank -%}
        <span class="lead-time-span visually-hidden" data-leadtime="{{ item_lead_time_days }}" data-leadtext="{{ item_lead_time_text | escape }}" data-line-key="{{ item.key }}"></span>
      {%- endif -%}
      <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
      {%- comment -%}
        Render related add-on line items that reference this product via properties.group_id
        Add-ons are identified by properties['Added as add-on'] == 'true' and properties.group_id == item.product_id
      {%- endcomment -%}
      {%- assign addon_related_count = 0 -%}
      {%- assign related_addon_total = 0 -%}
      {%- assign related_addon_original_total = 0 -%}
      {%- assign bundle_related_count = 0 -%}
      {%- assign related_bundle_total = 0 -%}
      {%- assign related_bundle_original_total = 0 -%}
      {%- for ci in cart.items -%}
        {%- if ci.properties._cart_text and ci.properties._group_id == item.properties._group_id -%}
          {% unless ci.properties._cart_text contains "Candles" or ci.properties._cart_text contains "Paint" %}
            {%- assign bundle_name = ci.properties._bundle_summary -%}
          {% endunless %}
        {%- endif -%}
        {%- if ci.properties['_Added as add-on'] == 'true' and ci.properties._group_id == item.properties._group_id -%}
          {%- assign addon_related_count = addon_related_count | plus: 1 -%}
          {%- assign related_addon_total = related_addon_total | plus: ci.final_line_price -%}
          {%- assign related_addon_original_total = related_addon_original_total | plus: ci.original_line_price -%}
        {%- endif -%}
        {%- if ci.properties['_bundle_child'] == 'true' and ci.properties._group_id == item.properties._group_id -%}
          {%- assign bundle_related_count = bundle_related_count | plus: 1 -%}
          {%- assign related_bundle_total = related_bundle_total | plus: ci.final_line_price -%}
          {%- assign related_bundle_original_total = related_bundle_original_total | plus: ci.original_line_price -%}
        {%- endif -%}
        {%- if ci.properties['_bundle_items'] and ci.properties._group_id == item.properties._group_id -%}
          {%- assign bundle_related_count = bundle_related_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign display_final_line_price = item.final_line_price | plus: related_addon_total | plus: related_bundle_total -%}
      {%- assign display_original_line_price = item.original_line_price | plus: related_addon_original_total | plus: related_bundle_original_total -%}
      
      {%- if addon_related_count > 0 -%}
        {%- assign addon_index = 0 -%}
        {%- assign addon_name = '' -%}
        {%- for sort_pos in (0..20) -%}
          {%- assign sort_str = sort_pos | append: '' -%}
          {%- for ci in cart.items -%}
            {%- if ci.properties['_Added as add-on'] == 'true' and ci.properties._group_id == item.properties._group_id and ci.properties._addon_sort == sort_str -%}
              {%- assign addon_index = addon_index | plus: 1 -%}
              {%- if ci.properties._addon_summary -%}
                {%- assign this_addon = ci.properties._addon_summary -%}
              {%- else -%}
                {%- assign this_addon = ci.product.metafields.custom.custom_product_title | default: ci.product.title -%}
              {%- endif -%}
              {%- assign addon_name = addon_name | append: this_addon -%}
              {%- if addon_index < addon_related_count -%}
                {%- assign addon_name = addon_name | append: ", " -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if bundle_related_count > 0 -%}
        {%- assign bundle_index = 0 -%}
        {%- for sort_pos in (0..20) -%}
          {%- assign sort_str = sort_pos | append: '' -%}
          {%- for ci in cart.items -%}
            {%- if ci.properties['_bundle_child'] == 'true' and ci.properties._group_id == item.properties._group_id and ci.properties._bundle_sort == sort_str -%}
              {%- assign bundle_index = bundle_index | plus: 1 -%}
              {%- if ci.properties._bundle_summary -%}
                {%- assign bundle_name = bundle_name | append: ci.properties._bundle_summary -%}
              {%- else -%}
                {%- assign bundle_name = bundle_name | append: ci.product.metafields.custom.custom_product_title | append: ", " -%}
              {%- endif -%}
              {%- if bundle_index < bundle_related_count -%}
                {%- assign bundle_name = bundle_name | append: ", " -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if bundle_name or addon_name -%}
        <div class="product-option">
          {% if bundle_name or addon_name %}
            Inc.
            {% if bundle_name %}
              <span class="cart-item__addon switch-bundle" data-addon-lines="{{ ci.product.selected_or_first_available_variant.id }}" data-index="{{ ci.index | plus: 1 }}">
                {{ bundle_name }}{%- if bundle_name != blank and addon_name != blank -%}, {% endif -%}
              </span>
            {% endif %}
              <span class="cart-item__addon" data-addon-lines="{{ ci.product.selected_or_first_available_variant.id }}" data-index="{{ ci.index | plus: 1 }}">
                {{ addon_name }}
              </span>
          {% endif %}
        </div>
      {% endif %}
      
    {%- endif -%}
    {% if item.properties == blank %}
      <span class="product__inventory cart-item-stock">{{ item.product.metafields.custom.lead_time.value }}</span>
    {% endif %}
    {%- if item.product.type == _cart_flooring_type and _item_show_m2 -%}
      <p class="cart-item__flooring-summary small-hide medium-hide" data-line-key="{{ item.key }}">{{ _item_ft2_display }} ft²</p>
    {%- endif -%}
    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
      {%- for discount in item.line_level_discount_allocations -%}
        <li class="discounts__discount">
          {{- 'icon-discount.svg' | inline_asset_content -}}
          {{ discount.discount_application.title | escape }}
        </li>
      {%- endfor -%}
    </ul>
    <div class="cart_item-remove-price__wrapper">
      {% comment %}
      {%- if item.original_price != item.final_price -%}
      <div class="cart-item__discounted-prices large-up-hide">
        <span class="visually-hidden">
          {{ 'products.product.price.regular_price' | t }}
        </span>
        <s class="cart-item__old-price product-option">
          {{- item.original_price | money -}}
        </s>
        <span class="visually-hidden">
          {{ 'products.product.price.sale_price' | t }}
        </span>
        <strong class="cart-item__final-price product-option">
          {{ item.final_price | money }}
        </strong>
      </div>
    {%- else -%}
      <div class="product-option">
        {{ item.original_price | money }}
      </div>
    {%- endif -%}
        {% endcomment %}
    {%- comment -%} Collect addon keys for this main item {%- endcomment -%}

    {%- assign addon_keys = '' -%}
    {%- for ci in cart.items -%}
      {%- if ci.properties['_Added as add-on'] == 'true' and ci.properties._group_id == item.properties._group_id and item.properties._group_id != blank -%}
        {%- if addon_keys == '' -%}
          {%- assign addon_keys = ci.key -%}
        {%- else -%}
          {%- assign addon_keys = addon_keys | append: ',' | append: ci.key -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    <cart-remove-button
      id="Remove-{{ item.index | plus: 1 }}"
      data-index="{{ item.index | plus: 1 }}"
      data-addon-keys="{{ addon_keys }}"
      data-main-key="{{ item.key }}"
    >
      <a
        href="{{ item.url_to_remove }}"
        class="button button--tertiary cart-remove-with-addons"
        aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
        {% if item.properties._group_id %}data-group-id="{{ item.properties._group_id }}"{% endif %}
      >
        <span class="svg-wrapper">
            Remove
        </span>
      </a>
    </cart-remove-button>
    </div>
  </td>

  <td class="cart-item__totals right small-hide medium-hide large-up-hide">
    {%- render 'loading-spinner' -%}
    <div class="cart-item__price-wrapper">
      {%- if display_original_line_price != display_final_line_price -%}
        <dl class="cart-item__discounted-prices">
          <dt class="visually-hidden">
            {{ 'products.product.price.regular_price' | t }}
          </dt>
          <dd>
            <s class="cart-item__old-price price price--end">
              {{ display_original_line_price | money }}
            </s>
          </dd>
          <dt class="visually-hidden">
            {{ 'products.product.price.sale_price' | t }}
          </dt>
          <dd class="price price--end">
            {{ display_final_line_price | money }}
          </dd>
        </dl>
      {%- else -%}
        <span class="price price--end">
          {{ display_original_line_price | money }}
        </span>
      {%- endif -%}

      {%- if item.variant.available and item.unit_price_measurement -%}
        <div class="unit-price caption">
          <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
          {{ item.unit_price | money}}
          <span aria-hidden="true">/</span>
          <span class="visually-hidden"
            >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
          >
          {%- if item.unit_price_measurement.reference_value != 1 -%}
            {{- item.unit_price_measurement.reference_value -}}
          {%- endif -%}
          {{ item.unit_price_measurement.reference_unit }}
        </div>
      {%- endif -%}
    </div>
  </td>
  {%- liquid
    assign has_qty_rules = false
    if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
      assign has_qty_rules = true
    endif

    assign has_vol_pricing = false
    if item.variant.quantity_price_breaks.size > 0
      assign has_vol_pricing = true
    endif
  -%}
  <td class="cart-item_custom__price medium-hide small-hide">
    {%- if item.original_price != item.final_price -%}
      <div class="cart-item__discounted-prices">
        <span class="visually-hidden">
          {{ 'products.product.price.regular_price' | t }}
        </span>
        <s class="cart-item__old-price product-option">
          {{- item.original_price | money -}}
        </s>
        <span class="visually-hidden">
          {{ 'products.product.price.sale_price' | t }}
        </span>
        <strong class="cart-item__final-price product-option">
          {{ item.final_price | money }}
        </strong>
      </div>
    {%- else -%}
      <div class="product-option">
        {{ item.original_price | money }}
      </div>
    {%- endif -%}

  </td>
  <td class="cart-item__quantity medium-hide small-hide{% if has_qty_rules or has_vol_pricing %} cart-item__quantity--info{% endif %}">
    <quantity-popover>
      <div class="cart-item__quantity-wrapper quantity-popover-wrapper">
        <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
          {{ 'products.product.quantity.label' | t }}
        </label>
        <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
          {%- if has_qty_rules or has_vol_pricing -%}
            <button
              type="button"
              aria-expanded="false"
              class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
            >
              {{- 'icon-info.svg' | inline_asset_content -}}
            </button>
          {%- endif -%}
          <quantity-input class="quantity cart-quantity">
            <button class="quantity__button" name="minus" type="button">
              <span class="visually-hidden">
                {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
              </span>
              <span class="svg-wrapper">
                {{- 'icon-minus.svg' | inline_asset_content -}}
              </span>
            </button>
            <input
              class="quantity__input"
              data-quantity-variant-id="{{ item.variant.id }}"
              type="text"
              inputmode="numeric"
              name="updates[]"
              value="{{ item.quantity }}"
              data-index="{{ item.index | plus: 1 }}"
              {% # theme-check-disable %}
              data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
              data-inventory-quantity="{{ item.variant.inventory_quantity }}"
              data-inventory-management="{{ item.variant.inventory_management }}"
              data-inventory-policy="{{ item.variant.inventory_policy }}"
              min="0"
              data-min="{{ item.variant.quantity_rule.min }}"
              {% if _per_item_limit > 0 %}
                max="{{ _per_item_limit }}"
              {% elsif item.variant.quantity_rule.max != null %}
                max="{{ item.variant.quantity_rule.max }}"
              {% endif %}
              step="{{ item.properties['_qty-step'] | default: item.properties['qty-step'] | default: 1 }}"
              {% if _cart_qty_limit > 0 %}
                data-cart-qty-limit="{{ _cart_qty_limit }}"
                data-cart-qty-limit-tag="{{ _cart_qty_limit_tag | escape }}"
                data-product-title="{{ item.product.title | escape }}"
              {% endif %}
              {% if _per_item_limit > 0 %}
                data-per-item-limit="{{ _per_item_limit }}"
              {% endif %}
              {% # theme-check-enable %}
              aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
              id="Quantity-{{ item.index | plus: 1 }}"
              data-group-id="{{ item.properties._group_id }}"
            >
            <button class="quantity__button" name="plus" type="button">
              <span class="visually-hidden">
                {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
              </span>
              <span class="svg-wrapper">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </button>
          </quantity-input>
          {%- if item.product.type == _cart_flooring_type -%}
            {%- if _item_is_fixed_tile -%}
              <span class="cart-unit-label">tiles</span>
            {%- else -%}
              <span class="cart-unit-label">m²</span>
            {%- endif -%}
          {%- endif -%}
        </div>
        {% comment %}
        <cart-remove-button
          id="Remove-{{ item.index | plus: 1 }}"
          data-index="{{ item.index | plus: 1 }}"
        >
          <a
            href="{{ item.url_to_remove }}"
            class="button button--tertiary"
            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-remove.svg' | inline_asset_content -}}
            </span>
          </a>
        </cart-remove-button>
        {% endcomment %}
      </div>
      {%- if has_qty_rules or has_vol_pricing -%}
        <button
          type="button"
          class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
          aria-expanded="false"
        >
          {{- 'icon-info.svg' | inline_asset_content -}}
          <span>
            {%- if has_vol_pricing -%}
              {{ 'products.product.volume_pricing.note' | t }}
            {%- elsif has_qty_rules -%}
              {{ 'products.product.quantity.note' | t }}
            {%- endif -%}
          </span>
        </button>
      {%- endif -%}
      {%- if has_vol_pricing or has_qty_rules -%}
        <div
          class="cart-items__info global-settings-popup quantity-popover__info"
          tabindex="-1"
          hidden
        >
          {%- if has_qty_rules == false -%}
            <span class="volume-pricing-label caption">
              {{- 'products.product.volume_pricing.title' | t -}}
            </span>
          {%- endif -%}
          <div class="quantity__rules caption">
            {%- if item.variant.quantity_rule.increment > 1 -%}
              <span class="divider">
                {{-
                  'products.product.quantity.multiples_of'
                  | t: quantity: item.variant.quantity_rule.increment
                -}}
              </span>
            {%- endif -%}
            {%- if item.variant.quantity_rule.min > 1 -%}
              <span class="divider">
                {{-
                  'products.product.quantity.min_of'
                  | t: quantity: item.variant.quantity_rule.min
                -}}
              </span>
            {%- endif -%}
            {%- if item.variant.quantity_rule.max != null -%}
              <span class="divider">
                {{-
                  'products.product.quantity.max_of'
                  | t: quantity: item.variant.quantity_rule.max
                -}}
              </span>
            {%- endif -%}
          </div>
          <button
            class="button-close button button--tertiary large-up-hide"
            type="button"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
          {%- if item.variant.quantity_price_breaks.size > 0 -%}
            <volume-pricing class="parent-display">
              <ul class="list-unstyled">
                <li>
                  <span>{{ item.variant.quantity_rule.min }}+</span>
                  {%- assign price = item.variant.price | money -%}
                  <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                </li>
                {%- for price_break in item.variant.quantity_price_breaks -%}
                  <li>
                    <span>
                      {{- price_break.minimum_quantity -}}
                      <span aria-hidden="true">+</span></span
                    >
                    {%- assign price = price_break.price | money -%}
                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            </volume-pricing>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
        <small class="cart-item__error-text"></small>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
      </div>
    </quantity-popover>
  </td>

  <td class="cart-item__totals right">
    <quantity-popover>
      {%- if item.product.type == _cart_flooring_type and _item_show_m2 -%}
        <p class="cart-item__flooring-summary large-up-hide" data-line-key="{{ item.key }}">{{ _item_ft2_display }} ft²</p>
      {%- endif -%}
      <div class="cart-item__quantity-wrapper quantity-popover-wrapper large-up-hide">
        <label class="visually-hidden" for="Quantity-{{ item.index | plus: 1 }}">
          {{ 'products.product.quantity.label' | t }}
        </label>
        <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
          {%- if has_qty_rules or has_vol_pricing -%}
            <button
              type="button"
              aria-expanded="false"
              class="quantity-popover__info-button quantity-popover__info-button--icon-only button button--tertiary small-hide medium-hide"
            >
              {{- 'icon-info.svg' | inline_asset_content -}}
            </button>
          {%- endif -%}
          <quantity-input class="quantity cart-quantity">
            
            <button class="quantity__button" name="minus" type="button">
              <span class="visually-hidden">
                {{- 'products.product.quantity.decrease' | t: product: item.product.title | escape -}}
              </span>
              <span class="svg-wrapper">
                {{- 'icon-minus.svg' | inline_asset_content -}}
              </span>
            </button>
            
            <input
              class="quantity__input"
              data-quantity-variant-id="{{ item.variant.id }}"
              type="text"
              inputmode="numeric"
              name="updates[]"
              value="{{ item.quantity }}"
              {% # theme-check-disable %}
              data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
              data-inventory-quantity="{{ item.variant.inventory_quantity }}"
              data-inventory-management="{{ item.variant.inventory_management }}"
              data-inventory-policy="{{ item.variant.inventory_policy }}"
              min="0"
              data-min="{{ item.variant.quantity_rule.min }}"
              {% if _per_item_limit > 0 %}
                max="{{ _per_item_limit }}"
              {% elsif item.variant.quantity_rule.max != null %}
                max="{{ item.variant.quantity_rule.max }}"
              {% endif %}
              step="{{ item.variant.quantity_rule.increment }}"
              {% if _cart_qty_limit > 0 %}
                data-cart-qty-limit="{{ _cart_qty_limit }}"
                data-cart-qty-limit-tag="{{ _cart_qty_limit_tag | escape }}"
                data-product-title="{{ item.product.title | escape }}"
              {% endif %}
              {% if _per_item_limit > 0 %}
                data-per-item-limit="{{ _per_item_limit }}"
              {% endif %}
              {% # theme-check-enable %}
              aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
              id="Quantity-{{ item.index | plus: 1 }}"
              data-index="{{ item.index | plus: 1 }}"
              data-group-id="{{ item.properties._group_id }}"
            >

            <button class="quantity__button" name="plus" type="button">
              <span class="visually-hidden">
                {{- 'products.product.quantity.increase' | t: product: item.product.title | escape -}}
              </span>
              <span class="svg-wrapper">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </button>
          </quantity-input>
          {%- if item.product.type == _cart_flooring_type -%}
            {%- if _item_is_fixed_tile -%}
              <span class="cart-unit-label">tiles</span>
            {%- else -%}
              <span class="cart-unit-label">m²</span>
            {%- endif -%}
          {%- endif -%}
        </div>
        {% comment %}
        <cart-remove-button
          id="Remove-{{ item.index | plus: 1 }}"
          data-index="{{ item.index | plus: 1 }}"
        >
          <a
            href="{{ item.url_to_remove }}"
            class="button button--tertiary"
            aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-remove.svg' | inline_asset_content -}}
            </span>
          </a>
        </cart-remove-button>
        {% endcomment %}
      </div>
      {%- if has_qty_rules or has_vol_pricing -%}
        <button
          type="button"
          class="quantity-popover__info-button quantity-popover__info-button--icon-with-label button button--tertiary large-up-hide"
          aria-expanded="false"
        >
          {{- 'icon-info.svg' | inline_asset_content -}}
          <span>
            {%- if has_vol_pricing -%}
              {{ 'products.product.volume_pricing.note' | t }}
            {%- elsif has_qty_rules -%}
              {{ 'products.product.quantity.note' | t }}
            {%- endif -%}
          </span>
        </button>
      {%- endif -%}
      {%- if has_vol_pricing or has_qty_rules -%}
        <div
          class="cart-items__info global-settings-popup quantity-popover__info"
          tabindex="-1"
          hidden
        >
          {%- if has_qty_rules == false -%}
            <span class="volume-pricing-label caption">
              {{- 'products.product.volume_pricing.title' | t -}}
            </span>
          {%- endif -%}
          <div class="quantity__rules caption">
            {%- if item.variant.quantity_rule.increment > 1 -%}
              <span class="divider">
                {{-
                  'products.product.quantity.multiples_of'
                  | t: quantity: item.variant.quantity_rule.increment
                -}}
              </span>
            {%- endif -%}
            {%- if item.variant.quantity_rule.min > 1 -%}
              <span class="divider">
                {{-
                  'products.product.quantity.min_of'
                  | t: quantity: item.variant.quantity_rule.min
                -}}
              </span>
            {%- endif -%}
            {%- if item.variant.quantity_rule.max != null -%}
              <span class="divider">
                {{-
                  'products.product.quantity.max_of'
                  | t: quantity: item.variant.quantity_rule.max
                -}}
              </span>
            {%- endif -%}
          </div>
          <button
            class="button-close button button--tertiary large-up-hide"
            type="button"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
          {%- if item.variant.quantity_price_breaks.size > 0 -%}
            <volume-pricing class="parent-display">
              <ul class="list-unstyled">
                <li>
                  <span>{{ item.variant.quantity_rule.min }}+</span>
                  {%- assign price = item.variant.price | money -%}
                  <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                </li>
                {%- for price_break in item.variant.quantity_price_breaks -%}
                  <li>
                    <span>
                      {{- price_break.minimum_quantity -}}
                      <span aria-hidden="true">+</span></span
                    >
                    {%- assign price = price_break.price | money -%}
                    <span> {{ 'sections.quick_order_list.each' | t: money: price }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            </volume-pricing>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="cart-item__error" id="Line-item-error-{{ item.index | plus: 1 }}" role="alert">
        <small class="cart-item__error-text"></small>
        <span class="svg-wrapper">
          {{- 'icon-error.svg' | inline_asset_content -}}
        </span>
      </div>
    </quantity-popover>
    {%- render 'loading-spinner' -%}
    <div class="cart-item__price-wrapper">
      {%- if display_original_line_price != display_final_line_price -%}
        <dl class="cart-item__discounted-prices">
          <dt class="visually-hidden">
            {{ 'products.product.price.regular_price' | t }}
          </dt>
          <dd>
            <s class="cart-item__old-price price price--end">
              {{ display_original_line_price | money }}
            </s>
          </dd>
          <dt class="visually-hidden">
            {{ 'products.product.price.sale_price' | t }}
          </dt>
          <dd class="price price--end">
            {{ display_final_line_price | money }}
          </dd>
        </dl>
      {%- else -%}
        <span class="price price--end">
          {{ display_original_line_price | money }}
        </span>
      {%- endif -%}

      {%- if item.variant.available and item.unit_price_measurement -%}
        <div class="unit-price caption">
          <span class="visually-hidden">{{ 'products.product.price.unit_price' | t }}</span>
          {{ item.unit_price | money}}
          <span aria-hidden="true">/</span>
          <span class="visually-hidden"
            >&nbsp;{{ 'accessibility.unit_price_separator' | t }}&nbsp;</span
          >
          {%- if item.unit_price_measurement.reference_value != 1 -%}
            {{- item.unit_price_measurement.reference_value -}}
          {%- endif -%}
          {{ item.unit_price_measurement.reference_unit }}
        </div>
      {%- endif -%}
    </div>
  </td>
</tr>
