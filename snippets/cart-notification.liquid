<div id="sr-message" class="visually-hidden" role="alert" ></div>
<div id="cart-popup-container" class="cart-popup-container" style="display: none;">
  <cart-notification>
    <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
      <div
        id="cart-notification"
        class="cart-notification focus-inset{% if color_scheme %} color-{{ color_scheme }} gradient{% endif %}"
        aria-label="{{ 'general.cart.item_added' | t }}"
        tabindex="-1"
      >
        <div class="cart-notification__header">
          <div class="cart-notification__heading caption-large text-body">
            <div class="added-message">has been added</div>
          </div>
        </div>
      </div>
    </div>
  </cart-notification>
</div>
