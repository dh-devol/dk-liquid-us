<style type="text/css">
    .custom__banner {
        background-color: #27333f;
        color: #fff;
    }
    .custom__banner .custom__banner--content .custom__banner--content-text a {
        color: #fff;
    }
    .custom__banner .custom__banner--content {
        max-width: var(--banner-width);
        width: 100%;
        margin: 0 auto;
        padding: 4rem 0;
        text-align: center;
        display: grid;
        grid-template-columns: minmax(44px, 1fr) auto minmax(44px, 1fr);
        column-gap: 0.5rem;
        align-items: start;
    }
    .custom__banner .custom__banner--content-text {
        grid-column: 2;
    }
    .custom__banner .custom__banner--content .custom__banner--close {
        grid-column: 3;
        justify-self: start;
        justify-content: flex-start;
    }
    .custom__banner .custom__banner--content .custom__banner--content-text p:first-of-type,
    .custom__banner .custom__banner--content .custom__banner--content-text p:last-of-type {
        margin: 0;
    }
    .custom__banner .custom__banner--content .custom__banner--close { 
        background: none;
        color: #fff;
        border: 0;
        padding: 0;
        cursor: pointer;
        min-width: 44px;
        min-height: 44px;
        display: inline-flex;
        align-self: flex-start;
        align-items: flex-start;
        justify-content: center;
        flex-shrink: 0;
    }
    .custom__banner a:focus-visible,
    .custom__banner .custom__banner--close:focus-visible {
        outline: var(--focused-base-outline);
        outline-offset: var(--focused-base-outline-offset);
        box-shadow: var(--focused-base-box-shadow);
    }
    @media (max-width:576px){
        .custom__banner .custom__banner--content {
            max-width: 88%;
            width: 92%;
            text-align: left;
        }
        .custom__banner .custom__banner--content .custom__banner--content-text .aesth {
            display: none;
        }
        .custom__banner .custom__banner--content {
            grid-template-columns: minmax(0, 1fr) 44px;
        }
        .custom__banner .custom__banner--content-text {
            grid-column: 1;
        }
        .custom__banner .custom__banner--content .custom__banner--close {
            grid-column: 2;
        }
    }
</style>

<section id="CustomBanner" class="custom__banner" aria-label="Announcement">
    <div class="custom__banner--content">
        <div class="custom__banner--content-text">
            {{ settings.banner_text }}
        </div>
        {% if settings.select_type == 'temporary' %}
            <button type="button" class="custom__banner--close" aria-label="Dismiss banner">
                <span class="svg-wrapper" aria-hidden="true">
                    {{ 'icon-close-small.svg' | inline_asset_content }}
                </span>
            </button>
        {% endif %}
    </div>
</section>

{% if settings.select_type == 'temporary' %}
    <script type="text/javascript">
        (function () {
            var banner = document.getElementById('CustomBanner');
            if (!banner) return;

            var key = 'customBannerDismissed';

            // Stay hidden if already dismissed this session
            try {
                if (sessionStorage.getItem(key)) {
                    banner.remove();
                    return;
                }
            } catch (e) {}

            banner.querySelector('.custom__banner--close').addEventListener('click', function () {
                banner.remove();
                try { 
                    sessionStorage.setItem(key, '1'); 
                } catch (e) {}
            });
        })();
    </script>
{% endif %}