{%- comment -%}
Renders one selectable product card for the mix & match UI.
Params:
  p: product object (required)
  limit: number (required)  // max per input (UI clamp)
{%- endcomment -%}

{%- if p -%}
  {%- capture variants_json -%}
    [
      {%- for v in p.variants -%}
        {
          "id": {{ v.id | json }},
          "title": {{ v.title | json }},
          "available": {{ v.available | json }},
          "price": {{ v.price | json }},
          "url": {{ p.url | append: '?variant=' | append: v.id | json }},
          "image": {%- if v.image -%}{{ v.image | image_url: width: 360 | json }}{%- else -%}{{ p.featured_image | image_url: width: 360 | json }}{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  {%- endcapture -%}

  <div class="mm-card"
       data-title="{{ p.title | escape }}"
       data-product-url="{{ p.url }}"
       data-variants='{{ variants_json | strip_newlines | escape }}'>
    <div class="mm-media">
      {%- if p.featured_image -%}
        <img src="{{ p.featured_image | image_url: width: 360 }}" alt="{{ p.title | escape }}" loading="lazy">
      {%- endif -%}
    </div>

    <div class="mm-info">
      <div class="mm-title">{{ p.title }}</div>

      {%- if p.has_only_default_variant == false -%}
        <label class="mm-variant-label">Variant</label>
        <select class="mm-variant-select" aria-label="Variant for {{ p.title | escape }}">
          {%- for v in p.variants -%}
            <option value="{{ v.id }}"
                    data-url="{{ p.url | append: '?variant=' | append: v.id }}"
                    data-image="{% if v.image %}{{ v.image | image_url: width: 360 }}{% else %}{{ p.featured_image | image_url: width: 360 }}{% endif %}"
                    {% unless v.available %}disabled{% endunless %}>
              {{ v.title }}{% unless v.available %} — Sold out{% endunless %}
            </option>
          {%- endfor -%}
        </select>
      {%- else -%}
        {%- assign v = p.selected_or_first_available_variant | default: p.first_available_variant | default: p.variants.first -%}
        <input type="hidden" class="mm-variant-select"
               value="{{ v.id }}"
               data-url="{{ p.url | append: '?variant=' | append: v.id }}"
               data-image="{% if v.image %}{{ v.image | image_url: width: 360 }}{% else %}{{ p.featured_image | image_url: width: 360 }}{% endif %}">
      {%- endif -%}

      <div class="mm-qty">
        <label>Qty</label>
        <input class="mm-qty-input" type="number" min="0" max="{{ limit }}" value="0"
               aria-label="Quantity for {{ p.title | escape }}">
      </div>
    </div>
  </div>
{%- endif -%}
