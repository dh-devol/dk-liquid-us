{%- if product.description != blank -%}
                <div class="product__description-wrapper">
                  <div
                    class="product__description rte quick-add-hidden {% if product.metafields.custom.read_more.value %}collapsed-open{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="description-content" data-maxheight-desktop="{{ product.metafields.custom.read_more_height.value | default: 220 }}" data-maxheight-mobile="{{ product.metafields.custom.read_more_height.value | default: 220 }}">
                      {{ product.description }}
                    </div>
                  </div>
                  {% if product.metafields.custom.read_more.value %}
                    <button class="read-more-toggle" type="button" aria-expanded="false" aria-controls="product-description">
                      Read more
                    </button>
                    <span class="dropdown-arrow" aria-hidden="true">▼</span>
                  {% endif %}
                </div>
              {%- endif -%}

                <style>
                   .product .product__description-wrapper .dropdown-arrow.icon_rotate{
                       transform: rotate(180deg);
                       display: inline-block;
                       transition: transform 0.3s ease;
                   }
                   .product .product__description-wrapper span.dropdown-arrow {
                      display: inline-block;
                      transition: transform 0.3s ease;
                      font-size: 8px;
                      margin-left: 10px;
                   }
                  .product .product__description-wrapper {
                    position: relative;
                  }

                  .product .product__description-wrapper .description-content {
                    {% if product.metafields.custom.read_more.value %}
                    max-height: {{ product.metafields.custom.read_more_height.value | default: 220 }}px;
                    {% endif %}
                    overflow: hidden;
                    position: relative;
                    transition: max-height 0.3s ease;
                  }

                  .product .product__description-wrapper .read-more-toggle {
                    background: none;
                    border: none;
                    color: #595959;
                    font-weight: 500;
                    cursor: pointer;
                    margin-top: 20px;
                    padding: 0;
                    font-family: "EB Garamond", serif;
                    font-size: 17px;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                  }
                  .dropdown-arrow { margin-left: 6px; }
                  .product .product__description-wrapper .description-content.collapsed {
                      mask: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0, rgba(0, 0, 0, 1) 60%, rgba(0, 0, 0, 0) 95%, rgba(0, 0, 0, 0) 0) 100% 50% / 100% 100% repeat-x;
                  }
                  /* Description container: allow JS to set max-height; default: no truncation for no-JS */
                  .description-content {
                    overflow: visible;          /* no-JS fallback: fully visible */
                    transition: max-height 0.35s ease;
                    position: relative;
                  }
                  .description-content.collapsed-by-js {
                    overflow: hidden;
                  }
                  .product__description-wrapper .description-content.collapsed-by-js::after {
                    content: "";
                    position: absolute;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    height: 4.5rem; /* fade height */
                    pointer-events: none;
                    background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,1) 100%);
                  }

                  /* Expanded state removes mask */
                  /* .description-content.expanded {
                    max-height: none !important;
                  } */
                  .description-content.expanded::after { display: none; }

                  .product .product__description-wrapper {
                      margin-top: 18px;; position: relative;
                  }
                  .product .product__description-wrapper .product__description {
                      margin-top: 0;
                      border-top: solid 1px rgba(0, 0, 0, 0.1);
                  }
                  .product .product__info-wrapper .product__text {
                      font-weight: 500;
                      font-size: 15px;
                  }
                  @media (min-width: 1100px) {
                    .product__description-wrapper .description-content {
                      /* min-height: 320px;       /* desktop large screens */
                    }
                  }
                  @media screen and (max-width: 590px) {
                    .product .product__description-wrapper .description-content {
                      /* min-height: 180px; */
                    }
                  }
                </style>