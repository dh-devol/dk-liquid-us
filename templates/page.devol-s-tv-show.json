      }
    },
    "multi_video_column_9C3CTe": {
      "type": "multi-video-column",
      "blocks": {
        "column_AF7nmP": {
          "type": "column",
          "settings": {
            "video_url": "https://youtu.be/V7kZQcedIAg",
            "title": "Welcome to Cotes Mill",
            "subtext": "",
            "text": "<p>deVOL welcomes you to take a look around our beautiful home, Cotes Mill, where we work and create our kitchens and so much more. We hope you enjoy it.</p>",
            "show_above_image": false,
            "link": ""
          }
        },
        "column_VNeFKM": {
          "type": "column",
          "settings": {
            "video_url": "https://youtu.be/8jKOfKT3I_M",
            "title": "How We Make Our Haberdasher's Cupboards",
            "subtext": "",
            "text": "<p>Peek inside the deVOL Haberdasher's workshop in Leicesterhire, England, to see our skilled craftspeople making this beautiful kitchen and all of it's little details.</p>",
            "show_above_image": false,
            "link": ""
          }
        },
        "column_iWBQkf": {
          "type": "column",
          "settings": {
            "video_url": "https://youtu.be/E_kuth2MltM",
            "title": "How We Make Our Lace Market Tiles",
            "subtext": "",
            "text": "<p>Beautiful patterned tiles created by pressing elegant lace designs into clay on an antique tile press at Cotes Mill.</p>",
            "show_above_image": false,
            "link": ""
          }
        },
        "column_YVfEJH": {
          "type": "column",
          "settings": {
            "video_url": "https://youtu.be/n_elpNerhF4",
            "title": "How We Make Cup Handles",
            "subtext": "",
            "text": "<p>A look at how deVOL's jeweller, Steph, casts our original cup handles, specially designed for our kitchens.</p>",
            "show_above_image": false,
            "link": ""
          }
        }
      },
      "block_order": [
        "column_AF7nmP",
        "column_VNeFKM",
        "column_iWBQkf",
        "column_YVfEJH"
      ],
      "custom_css": [
        ".multicolumn-card__info {padding-top: 8px;}"
      ],
