    "title_with_rich_text_bCDT46": {
      "type": "title-with-rich-text",
      "blocks": {
        "heading_RpceYP": {
          "type": "heading",
          "settings": {
            "heading": "deVOL Films",
            "heading_size": "hxxl"
          }
        },
        "text_AKF6LJ": {
          "type": "text",
          "settings": {
            "text": "<p>From a full blown TV show, to our very own films, we love to share snippets of our unique and intricate design processes, take you behind the scenes in our workshops and studios and show you a little insight in to the life at Cotes Mill.</p>"
          }
        }
      },
      "block_order": [
        "heading_RpceYP",
        "text_AKF6LJ"
      ],
      "custom_css": [],
