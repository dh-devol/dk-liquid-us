thumb","settings":{"image":"shopify:\/\/shop_images\/Pink-Green-2.jpg"}}},"block_order":["slider_thumb_A63KmC","slider_thumb_G6XzCq","slider_thumb_8QpAwx","slider_thumb_yKcjf7","slider_thumb_VDzURj","slider_thumb_xgghPJ","slider_thumb_eYzX9X","slider_thumb_97LFCD","slider_thumb_7heKkL","slider_thumb_pWjBXK"],"disabled":true,"settings":{"color_scheme":"scheme-3","padding_top":0,"padding_bottom":0,"sectionname":""}},"page_title_description_RFMqFk":{"type":"page-title-description","name":"Page title & description","settings":{"show_title":true,"show_description":true,"description_columns":2,"color_scheme":"scheme-2","padding_top":0,"padding_bottom":0}},"custom_multicolumns_xpBCAp":{"type":"custom-multicolumns","blocks":{"column_W4R47Y":{"type":"column","settings":{"link":"","anchor":"","dynamic_costs":"","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>deVOL is very happy to announce that we have opened a showroom in Bath, a world heritage city and one of the great spa towns of Europe. We were lured by its exceptional Georgian architecture and the warm glow that Bath Stone radiates as soon as you enter the city.<br\/><br\/><\/p><p>We have found a classic corner shop of the grandest proportions and are making each room into an atmospheric kitchen where you can come and immerse yourself in deVOL and the incredible original features of this beautiful building. The showroom is listed, and we have paid particular attention to all the details and designed our displays around these typical Georgian features. deVOL Classic cupboards were originally designed<\/p>","show_above_image":true,"link_label":"","linked_product":""}},"column_fB3ekK":{"type":"column","settings":{"link":"","anchor":"","dynamic_costs":"","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>around Georgian proportions so we have focused on our Classic English, Heirloom and Shaker ranges to ensure that the displays feel authentic and in keeping with their surroundings.<br\/><br\/><\/p><p>A visit to Bath in Somerset is quite delightful in every way, it is visually stunning and filled with street after street of cafés, bars, restaurants, and beautifully curated shops. We have a small team of designers just waiting to guide you through the design service and offer you all the advice and help you need; they will be offering exactly the same personal, creative, and informative service we offer in all our showrooms. We can’t wait to show you around our new place and are looking forward to getting to know Bath.<\/p>","show_above_image":true,"link_label":"","linked_product":""}}},"block_order":["column_W4R47Y","column_fB3ekK"],"disabled":true,"custom_css":["@media (max-width: 500px) {.description_above--image {margin-bottom: -20px; } li#Slide-template--25344077005134__custom_multicolumns_xpBCAp-2 {margin-top: -20px; }}"],"settings":{"title":"","heading_size":"h1","subtitle":"A historic new showroom in Bath","image_width":"full","image_ratio":"adapt","columns_desktop":2,"column_alignment":"left","background_style":"none","button_label":"","button_link":"","show_top_border":false,"show_bottom_border":false,"color_scheme":"scheme-2","columns_mobile":"1","swipe_on_mobile":false,"padding_top":36,"padding_bottom":0,"sectionname":"showroom__description-wrapper"}},"title_with_rich_text_i7x9Vg":{"type":"title-with-rich-text","blocks":{"heading_B84MtT":{"type":"heading","settings":{"heading":"Come and visit us","heading_size":"hxxl"}},"text_T7TL7a":{"type":"text","settings":{"text":"{{ page.metafields.custom.showroom_timing | metafield_tag }}"}},"text_KkfQhM":{"type":"text","settings":{"text":"{{ page.metafields.custom.showroom_additional_note | metafield_tag }}"}},"text_k7ckVz":{"type":"text","settings":{"text":"<p>17 George Street, Bath, Somerset, BA1 2EN<\/p><p><a href=\"tel:+44 1225 308803\" title=\"tel:+44 1225 308803\">+44 1225 308803<\/a>   |    <a href=\"mailto:bath.enquiries@devolkitchens.co.uk \" target=\"_blank\" title=\"mai