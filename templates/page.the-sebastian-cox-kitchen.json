e,"show_bottom_border":false,"color_scheme":"scheme-2","columns_mobile":"1","swipe_on_mobile":false,"padding_top":0,"padding_bottom":0,"sectionname":""}},"custom_liquid_FnibFQ":{"type":"custom-liquid","name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<div class=\"custom-multicolumn  scroll-id\" style=\"opacity:0; margin-bottom: -70px;\" id=\"about\" >static<\/div>","color_scheme":"","padding_top":0,"padding_bottom":4}},"custom_multicolumns_GEDpQn":{"type":"custom-multicolumns","blocks":{"column_hTdkwx":{"type":"column","settings":{"link":"","dynamic_costs":"","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>This is the first kitchen we designed as a collaboration, so it strays a little from our original Shaker and Classic ranges. What doesn’t differ is that it is handmade with great attention to detail and the always important deVOL ethos of simplicity and longevity is still right at the heart of this award-winning design.<\/p>","show_above_image":true,"link_label":"","linked_product":""}},"column_Tqctir":{"type":"column","settings":{"link":"","dynamic_costs":"","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>If you are looking for provenance, rustic beauty, elegance and something a little out of the ordinary, this is the perfect range to look at. The cupboards are ideal for large spaces, industrial or retro homes, barns and basements, or large live-in cook-in spaces with lots of light and glass. Its textured surfaces, woven delicateness and airy qualities have been loved by our customers all over the world and when mixed with our copper and rustic oak worktops, it is truly a work of art.<\/p>","show_above_image":true,"link_label":"","linked_product":""}}},"block_order":["column_hTdkwx","column_Tqctir"],"disabled":true,"custom_css":[".multicolumn .title {margin-bottom: 66px;}","@media screen and (max-width: 749px) {.custom-multicolumn .title-wrapper-with-link .title {font-size: 24px; }}","@media (max-width: 590px) {.custom-multicolumn .multicolumn-list .grid__item:first-child {margin-bottom: 3px; } .custom-multicolumn .multicolumn-list .grid__item {margin-bottom: 33px; }}"],"settings":{"title":"A True Collaboration","heading_size":"hxxl","subtitle":"","image_width":"full","image_ratio":"adapt","columns_desktop":2,"column_alignment":"left","background_style":"none","button_label":"","button_link":"#","show_top_border":true,"show_bottom_border":false,"color_scheme":"scheme-2","columns_mobile":"1","swipe_on_mobile":false,"padding_top":56,"padding_bottom":0,"sectionname":"top__text-section"}},"custom_multicolumns_cGajTJ":{"type":"custom-multicolumns","blocks":{"column_4TXjHn":{"type":"column","settings":{"link":"","dynamic_costs":"","image":"shopify:\/\/shop_images\/SebCox-Editorial-01.jpg","custom_text_hover":"","title":"","show_text_double_column":false,"text":"","show_above_image":false,"link_label":"","linked_product":""}}},"block_order":["column_4TXjHn"],"disabled":true,"settings":{"title":"","heading_size":"hxxl","subtitle":"","image_width":"full","image_ratio":"adapt","columns_desktop":1,"column_alignment":"left","background_style":"none","button_label":"","button_link":"#","show_top_border":false,"show_bottom_border":false,"color_scheme":"scheme-2","columns_mobile":"1","swipe_on_mobile":false,"padding_top":0,"padding_bottom":0,"sectionname":"top__text-section"}},"custom_multicolumns_iWYyWE":{"type":"custom-multicolumns","blocks":{"column_fjwhgQ":{"type":"column","settings":{"link":"","dynamic_costs":"","image":"shopify:\/\/shop_images\/SebCox-Editorial-02_1.jpg","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>We have always encouraged our customers to ask the question, ‘where is it made?’ and then check for themselves. It is important to know what you are buying and who you are supporting. This design is a mix of everything that both Sebastian and deVOL are passionate about. It’s a culmination of good taste, modern innovation, traditional techniques and true inspiration. <\/p>","show_above_image":true,"link_label":"","linked_product":""}},"column_AYEyR3":{"type":"column","settings":{"link":"","dynamic_costs":"","image":"shopify:\/\/shop_images\/SebCox-Editorial-02_2.jpg","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>Sebastian Cox is an inspired young British designer, a lover of woodland and champion of eco-diversity. We met at a summer design show in London and we were instantly impressed by his unique approach to design and his dream of restoring coppiced woodland to the British countryside. We invited him up to Cotes Mill and the potential for a fantastic new collaboration became clear very quickly.<\/p>","show_above_image":true,"link_label":"","linked_product":""}},"column_XLdKNk":{"type":"column","settings":{"link":"","dynamic_costs":"","image":"shopify:\/\/shop_images\/SebCox-Editorial-03_1.jpg","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>The range of cupboards we designed together has become quite iconic. They offer impeccable cupboards with a slightly more edgy look to them, not trendy but just a little more quirky. We have come to think of the look as ‘urban rustic’; it brings a little bit of woodland into the city, with some style. As Sebastian puts it, “The whole kitchen is designed to look like it breathes. Together we’ve created something that feels clean, simple and light but is brimming with subtle texture to keep the choice of material at the forefront.”<\/p><p>As with all of our kitchen furniture, every cupboard is expertly made by hand in our Leicestershire workshops. We chose to use sustainable timbers such as beech and ash with a selection of coloured dyes that stain the wood, rather than laying on top like paint. This allows the texture of the wood to remain visible for a satisfyingly tactile finish. The closed<\/p>","show_above_image":true,"link_label":"","linked_product":""}},"column_RTwmTG":{"type":"column","settings":{"link":"","dynamic_costs":"","image":"shopify:\/\/shop_images\/SebCox-Editorial-03_2.jpg","custom_text_hover":"","title":"","show_text_double_column":false,"text":"<p>cupboard doors are a real triumph; straight beech planks of varying widths with a uniform band-sawn texture, fixed to sliding dovetailed ash braces running behind. Here the natural tendencies of the material were allowed to govern every feature of the construction, leading to a design that looks right because it makes sense. We also wanted the wall cupboards to feel particularly lightweight in contrast to the closed base cupboards, designing them with thin frames, heritage glass and breathable woven ash back panels.<\/p><p><\/p><p>The range was an instant hit, winning Kitchen Design of the Year and a Design Guild Mark for excellence in British design. It has proved popular with creative professionals living all over the world, from a Beverley Hills ranch to a warehouse loft apartment in East London, these beautifully tactile cupboards are really rather versatile.<\/p>","show_above_image":true,"link_label":"","linked_product":""}}},"block_order":["column_fjwhgQ","column_AYEyR3","column_XLdKNk","column_RTwmTG"],"disabled":true,"custom_css":[".description_above--image {margin-top: 25px; margin-bottom: 50px;}","#top__text-section li:nth-last-child(2),li:nth-last-child(1) {margin-bottom: 0;}",".top__section-border:before {display: none;}","#top__text-section li:nth-last-child(2) p:not(:last-child),#top__text-section li:nth-last-child(1) p:not(:last-child) {margin-bottom: 16px;}","@media screen and (max-width: 590px) {#top__text-section li:nth-last-child(2), li:nth-last-child(1) {margin-bottom: 33px; }}"],"settings":{"title":"","heading_size":"hxxl","subtitle":"","image_width":"full","image_ratio":"adapt","columns_desktop":2,"column_alignment":"left","background_style":"none","button_label":"","button_link":"#","show_top_border":true,"show_bottom_border":true,"color_scheme":"scheme-2","columns_mobile":"1","swipe_on_mobile":false,"padding_top":16,"padding_bottom":76,"sectionname":"top__text-section"}},"editorials_JTY6xa":{"type":"editorials","name":"Editorials","settings":{}},"image_with_rich_text_nhWMWe":{"type":"image-with-rich-text","blocks":{"image_yyDTxm":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/The_deVOL_Brochure_-_Spring_2024_0.jpg"}},"heading_BPnLCt":{"type":"heading","settings":{"heading":"The deVOL Brochure","heading_size":"hxxl"}},"text_Ee4K7j":{"type":"text","settings":{"text":"<p>Within the pages of our brochure you’ll find inspirational kitchen projects and learn more about our five beautiful ranges.<\/p>"}},"button_pxGzQf":{"type":"button","settings":{"button_label":"Order your copy","button_link":"shopify:\/\/products\/devol-brochure","button_style_secondary":false,"button_label_2":"","button_link_2":"","button_style_secondary_2":false}}},"block_order":["image_yyDTxm","heading_BPnLCt","text_Ee4K7j","button_pxGzQf"],"custom_css":[".rich-text {padding-bottom: 54px;}","@media screen and (max-width: 768px) {.rich-text {padding-top: 2em; padding-bottom: 0; }}"],"settings":{"desktop_content_position":"center","content_alignment":"center","dynamic_section_link":"shopify:\/\/pages\/brochure","color_scheme":"scheme-2","full_width":true,"padding_top":32,"padding_bottom":0}}},"order":["main","metaobject_gallery_slider_PtmNkY","catalogue_title_with_richtext_bMydKG","project_multicolumns_UGjxfC","project_multicolumns_qRnh3q","custom_liquid_FnibFQ","custom_multicolumns_GEDpQn","custom_multicolumns_cGajTJ","custom_multicolumns_iWYyWE","editorials_JTY6xa","image_with_rich_text_nhWMWe"]}